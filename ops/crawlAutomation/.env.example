# Portal credentials (only used for auto-login when the saved session expired)
TECHNO_USERNAME=your-username
TECHNO_PASSWORD=your-password

# Optional overrides (defaults in lib/browser.mjs)
# Camoufox profile dir that holds a logged-in session for the portal.
#   Windows default: C:\Users\<you>\.camofox\profiles\<id>  (existing dev profile)
#   Linux default:   ~/.camofox/profiles/technoproperty
# TECHNO_PROFILE_DIR=/home/you/.camofox/profiles/technoproperty
# Portal base URL
TECHNO_BASE_URL=https://ahmedabad.technoproperty.in
# Headless mode: 1 = headless, 0 = headed. Default is headless on Linux/macOS,
# headed on Windows. CLI flags --headless / --headed override this.
CAMOUFOX_HEADLESS=1
