# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

TECHNO_USERNAME=
TECHNO_PASSWORD=

# Optional overrides (defaults in lib/browser.mjs)
# Camoufox profile dir that holds a logged-in session for the portal.
TECHNO_PROFILE_DIR=C:\Users\YOURUSER\.camofox\profiles\YOURPROFILEID
# Portal base URL
TECHNO_BASE_URL=https://ahmedabad.technoproperty.in