{
  "name": "architech-web",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "node scripts/build-publish.mjs",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "lint": "eslint app client/src --max-warnings 200",
    "test": "vitest run",
    "format": "prettier --write .",
    "test:seo": "pnpm build:ci && node scripts/seo/raw-html-smoke.mjs",
    "test:a11y": "playwright test --config playwright.a11y.config.ts",
    "storybook": "storybook dev --host 0.0.0.0 -p 6006",
    "storybook:smoke": "storybook dev --host 0.0.0.0 -p 6006 --ci --smoke-test",
    "build-storybook": "storybook build",
    "test:perf": "pnpm build:ci && node scripts/performance/budget.mjs",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "location:fetch:ogd": "node scripts/location/fetch-ogd-snapshot.mjs",
    "location:fetch:india-post": "node scripts/location/fetch-ogd-snapshot.mjs --resource india-post --output tmp/location/india-post.csv",
    "location:fetch:lgd": "node scripts/location/fetch-ogd-snapshot.mjs --resource lgd-local-bodies --output tmp/location/lgd-local-bodies.csv",
    "location:import": "node scripts/location/import-india-post.mjs",
    "location:import:india-post": "node scripts/location/import-india-post.mjs",
    "location:import:lgd": "node scripts/location/import-lgd-local-bodies.mjs",
    "location:coverage:audit": "node scripts/location/audit-coverage.mjs",
    "location:import:test": "node --test scripts/location/*.test.mjs",
    "privacy:requirements:purge": "node scripts/privacy/purge-expired-requirements.mjs",
    "privacy:requirements:test": "node --test scripts/privacy/*.test.mjs",
    "seo:gsc:audit": "node scripts/seo/search-console-audit.mjs",
    "security:headers": "node scripts/security/header-audit.mjs",
    "legal:gates": "node scripts/security/legal-gate-audit.mjs",
    "security:audit": "pnpm security:headers && pnpm legal:gates",
    "ops:audit": "node scripts/operations/readiness-audit.mjs",
    "release:audit": "node scripts/release/phase-1-release-audit.mjs",
    "quality": "pnpm check && pnpm lint && pnpm test && pnpm db:validate",
    "build:ci": "node scripts/build-ci.mjs",
    "production:plan:audit": "node scripts/release/production-enablement-audit.mjs",
    "env:audit": "node scripts/operations/environment-audit.mjs",
    "secrets:audit": "node scripts/operations/secrets-audit.mjs",
    "provisioning:audit": "pnpm env:audit && pnpm secrets:audit && pnpm production:plan:audit && pnpm provisioning:smoke",
    "provisioning:smoke": "node scripts/operations/provisioning-smoke.mjs"
  },
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.71.0",
    "better-auth": "^1.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "maplibre-gl": "^6.5.0",
    "motion": "^13.1.1",
    "next": "^16.3.2",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/nextjs-vite": "^10.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "eslint": "^9.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^15.12.0",
    "prettier": "^3.6.2",
    "prisma": "^7.9.1",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^7",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
