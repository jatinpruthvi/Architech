{
  "name": "architech-web",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "node ops/scripts/build-publish.mjs",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "lint": "eslint src --max-warnings 200",
    "audit:contrast": "node ops/scripts/audit-surface-contrast.mjs",
    "audit:mobile": "node ops/scripts/audit/mobile-audit.mjs",
    "audit:pwa": "node ops/scripts/audit/pwa-audit.mjs",
    "test": "vitest run",
    "format": "prettier --write .",
    "test:seo": "node ops/scripts/seo/run-seo-suite.mjs",
    "test:crawl": "pnpm build:ci && node ops/scripts/seo/crawl-simulation.mjs",
    "test:e2e": "pnpm build:ci && node tests/e2e/run-all.mjs",
    "test:e2e:only": "node tests/e2e/run-all.mjs",
    "test:a11y": "playwright test --config playwright.a11y.config.ts",
    "test:ui": "playwright test --config playwright.ui.config.ts",
    "storybook": "storybook dev --host 0.0.0.0 -p 6006",
    "storybook:smoke": "storybook dev --host 0.0.0.0 -p 6006 --ci --smoke-test",
    "build-storybook": "storybook build",
    "test:perf": "pnpm build:ci && node ops/scripts/performance/budget.mjs",
    "perf:shell": "node ops/scripts/performance/shell-report.mjs",
    "db:validate": "prisma validate",
    "db:validate:offline": "node ops/scripts/sandbox/install-schema-engine-shim.mjs && prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:setup:sandbox": "node ops/scripts/sandbox/setup-local-db.mjs",
    "baseline:worktree": "node ops/scripts/sandbox/baseline-worktree.mjs",
    "location:fetch:ogd": "node ops/scripts/location/fetch-ogd-snapshot.mjs",
    "location:fetch:india-post": "node ops/scripts/location/fetch-ogd-snapshot.mjs --resource india-post --output tmp/location/india-post.csv",
    "location:fetch:lgd": "node ops/scripts/location/fetch-ogd-snapshot.mjs --resource lgd-local-bodies --output tmp/location/lgd-local-bodies.csv",
    "location:import": "node ops/scripts/location/import-india-post.mjs",
    "location:import:india-post": "node ops/scripts/location/import-india-post.mjs",
    "location:import:lgd": "node ops/scripts/location/import-lgd-local-bodies.mjs",
    "location:coverage:audit": "node ops/scripts/location/audit-coverage.mjs",
    "location:import:test": "node --test ops/scripts/location/*.test.mjs",
    "privacy:leads:purge": "node ops/scripts/privacy/purge-expired-leads.mjs",
    "privacy:leads:test": "node --test ops/scripts/privacy/purge-expired-leads.test.mjs",
    "privacy:requirements:purge": "node ops/scripts/privacy/purge-expired-requirements.mjs",
    "privacy:requirements:test": "node --test ops/scripts/privacy/*.test.mjs",
    "seo:gsc:audit": "node ops/scripts/seo/search-console-audit.mjs",
    "security:headers": "node ops/scripts/security/header-audit.mjs",
    "security:rls": "node ops/scripts/security/rls-audit.mjs",
    "legal:gates": "node ops/scripts/security/legal-gate-audit.mjs",
    "security:audit": "pnpm security:headers && pnpm security:rls && pnpm legal:gates",
    "ops:audit": "node ops/scripts/operations/readiness-audit.mjs",
    "release:audit": "node ops/scripts/release/phase-1-release-audit.mjs",
    "quality": "pnpm check && pnpm lint && pnpm test && pnpm db:validate",
    "build:ci": "node ops/scripts/build-ci.mjs",
    "production:plan:audit": "node ops/scripts/release/production-enablement-audit.mjs",
    "env:audit": "node ops/scripts/operations/environment-audit.mjs",
    "secrets:audit": "node ops/scripts/operations/secrets-audit.mjs",
    "provisioning:audit": "pnpm env:audit && pnpm secrets:audit && pnpm production:plan:audit && pnpm provisioning:smoke",
    "provisioning:smoke": "node ops/scripts/operations/provisioning-smoke.mjs",
    "start:next": "node node_modules/next/dist/bin/next start",
    "start:static": "node dist/index.js",
    "whatsapp:setup": "node ops/scripts/whatsapp/evolution-setup.mjs",
    "ops:test": "node --test ops/scripts/**/*.test.mjs",
    "whatsapp:worker": "node ops/scripts/whatsapp/outbox-worker.mjs",
    "whatsapp:test": "node --test ops/scripts/whatsapp/*.test.mjs",
    "test:a11y:broker": "playwright test --config playwright.a11y.broker.config.ts",
    "icons:maskable": "node ops/scripts/media/generate-maskable-icon.mjs",
    "audit:pwa:ci": "node ops/scripts/audit/run-pwa-audit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.71.0",
    "better-auth": "^1.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.453.0",
    "maplibre-gl": "^6.5.0",
    "motion": "^13.1.1",
    "next": "^16.3.2",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/nextjs-vite": "^10.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^15.12.0",
    "pg": "^8.23.0",
    "prettier": "^3.6.2",
    "prisma": "^7.9.1",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^7",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "node db/seed.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@tailwindcss/oxide",
      "esbuild",
      "prisma"
    ]
  }
}
