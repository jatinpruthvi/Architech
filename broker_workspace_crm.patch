+import { ref } from 'vue'
+import { createResource, Button } from 'frappe-ui'
+import WhatsAppModal from '@/components/Broker/WhatsAppModal.vue'
+import { generateBuyerMatchGreeting, launchWhatsApp } from '@/utils/whatsapp'
+
+const props = defineProps({
+  requirementId: { type: String, required: true },
+})
+
+const showWhatsAppModal = ref(false)
+const activeShareProperty = ref(null)
+
+const matchesResource = createResource({
+  url: 'crm.api.matching.get_property_matches',
+  params: { requirement_id: props.requirementId, limit: 30 },
+  auto: true,
+})
+
+function shareSingleMatch(property) {
+  activeShareProperty.value = property
+  showWhatsAppModal.value = true
+}
+
+function shareTopMatches() {
+  const req = matchesResource.data?.requirement
+  const matches = (matchesResource.data?.matches || []).map((m) => m.property)
+  if (!req || !matches.length) return
+
+  const message = generateBuyerMatchGreeting(req.client_name, matches)
+  launchWhatsApp(req.client_phone, message)
+}
+
+function tierBadgeClass(tier) {
+  switch (tier) {
+    case 'strong':
+      return 'bg-green-100 text-green-800 border border-green-200'
+    case 'good':
+      return 'bg-blue-100 text-blue-800 border border-blue-200'
+    case 'possible':
+      return 'bg-amber-100 text-amber-800 border border-amber-200'
+    default:
+      return 'bg-gray-100 text-gray-700'
+  }
+}
+
+function formatPrice(val) {
+  if (!val) return '0'
+  const n = Number(val)
+  if (n >= 10000000) return (n / 10000000).toFixed(2) + ' Cr'
+  if (n >= 100000) return (n / 100000).toFixed(2) + ' L'
+  return n.toLocaleString('en-IN')
+}
+</script>
