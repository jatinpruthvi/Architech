+
+describe('Validation 3: Mobile PWA Responsiveness & Native Device Hook Validation', () => {
+  describe('Phone Number Normalization for WhatsApp & Dialer', () => {
+    it('normalizes 10-digit Indian phone number with 91 prefix', () => {
+      assert.strictEqual(normalizePhoneForWhatsApp('9876543210'), '919876543210')
+      assert.strictEqual(normalizePhoneForWhatsApp('98765 43210'), '919876543210')
+      assert.strictEqual(normalizePhoneForWhatsApp('98765-43210'), '919876543210')
+    })
+
+    it('preserves existing 91 prefix on 12-digit numbers', () => {
+      assert.strictEqual(normalizePhoneForWhatsApp('919876543210'), '919876543210')
+      assert.strictEqual(normalizePhoneForWhatsApp('+91 98765 43210'), '919876543210')
+    })
+
+    it('returns empty string for null, undefined or empty phone', () => {
+      assert.strictEqual(normalizePhoneForWhatsApp(null), '')
+      assert.strictEqual(normalizePhoneForWhatsApp(undefined), '')
+      assert.strictEqual(normalizePhoneForWhatsApp(''), '')
+    })
+  })
+
+  describe('Dialer tel: URI sanitization', () => {
+    function sanitizeForDialer(phone) {
+      if (!phone) return ''
+      // Strip whitespace, hyphens, parentheses, but keep leading + and digits
+      return `tel:${phone.replace(/[^\d+]/g, '')}`
+    }
+
+    it('formats clean tel: protocol URLs', () => {
+      assert.strictEqual(sanitizeForDialer('+91 98765 43210'), 'tel:+919876543210')
+      assert.strictEqual(sanitizeForDialer('079-2685-1234'), 'tel:07926851234')
+      assert.strictEqual(sanitizeForDialer('(022) 2854 9999'), 'tel:02228549999')
+    })
+
+    it('handles empty input gracefully', () => {
+      assert.strictEqual(sanitizeForDialer(''), '')
+      assert.strictEqual(sanitizeForDialer(null), '')
+    })
+  })
+
+  describe('WhatsApp Property Brochure Generator', () => {
+    it('formats a rich brochure with emojis, price, and specs', () => {
