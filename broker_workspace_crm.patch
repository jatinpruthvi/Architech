+      </Button>
+
+      <template v-else>
+        <Button
+          variant="solid"
+          iconLeft="phone"
+          class="flex-1"
+          @click="makeCall(detail.data.property.owner_phone)"
+        >
+          {{ __('Call Now') }}
+        </Button>
+        <Button
+          variant="outline"
+          iconLeft="message-circle"
+          class="flex-1"
