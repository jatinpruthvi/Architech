+            class="w-full p-2.5 text-xs rounded-xl border border-outline-gray-1 bg-surface-base"
+          />
+        </div>
+
+        <div class="space-y-1 text-xs">
+          <label class="font-semibold text-ink-gray-7">{{ __('Notes:') }}</label>
+          <textarea
+            v-model="mobileFollowUpNote"
+            rows="2"
+            class="w-full p-2.5 text-xs rounded-xl border border-outline-gray-1 bg-surface-base"
+            :placeholder="__('Add conversation note...')"
+          ></textarea>
+        </div>
+
+        <div class="pt-2 flex items-center gap-2">
+          <Button variant="subtle" class="flex-1" @click="activeMobileFollowUp = null">
+            {{ __('Cancel') }}
+          </Button>
+          <Button variant="solid" class="flex-1" :loading="savingMobileFollowUp" @click="saveMobileFollowUp">
+            {{ __('Save Callback') }}
+          </Button>
+        </div>
+      </div>
+    </div>
+  </div>
+</template>
+
+<script setup>
+import { ref, computed } from 'vue'
+import { Button } from 'frappe-ui'
+import { brokerStore } from '@/stores/broker'
+
+const { queue, logOutcome, revealContact } = brokerStore()
+
+const activeFilter = ref('all')
+const activeMobileFollowUp = ref(null)
+const mobileFollowUpDate = ref('')
+const mobileFollowUpNote = ref('')
+const savingMobileFollowUp = ref(false)
+
+const filterChips = [
+  { key: 'all', label: 'All' },
+  { key: 'follow_up', label: 'Callbacks' },
+  { key: 'fresh', label: 'Fresh' },
+  { key: 'retry', label: 'Retries' },
+]
+
+const filteredQueue = computed(() => {
+  const list = queue.data?.queue || []
+  if (activeFilter.value === 'follow_up') {
+    return list.filter((i) => i.current_outcome === 'Follow Up')
+  }
+  if (activeFilter.value === 'fresh') {
+    return list.filter((i) => !i.last_call_at)
+  }
+  if (activeFilter.value === 'retry') {
+    return list.filter((i) => i.current_outcome === 'No Answer')
+  }
+  return list
+})
+
+function dial(phone) {
+  if (!phone) return
+  window.location.href = `tel:${phone.replace(/\s+/g, '')}`
+}
+
+function openWhatsApp(phone, title) {
+  if (!phone) return
+  const cleanPhone = phone.replace(/\D/g, '')
+  const msg = encodeURIComponent(`Hello, I am following up regarding ${title}.`)
+  window.open(`https://api.whatsapp.com/send?phone=${cleanPhone}&text=${msg}`, '_blank')
+}
+
+async function handleRevealMobile(item) {
+  const res = await revealContact(item.name, 'Mobile App')
+  if (res?.ok) {
+    item.revealed = true
+    item.owner_phone = res.owner_phone
+  }
+}
+
+async function fastLog(item, outcome) {
+  await logOutcome(item.name, outcome)
+}
+
+function openMobileFollowUp(item) {
+  activeMobileFollowUp.value = item
+  setMobilePreset(1, 9, 30)
+  mobileFollowUpNote.value = ''
+}
+
+function setMobilePreset(days, hour, minute) {
+  const d = new Date(Date.now() + days * 86400000)
+  d.setHours(hour, minute, 0, 0)
+  mobileFollowUpDate.value = d.toISOString().slice(0, 16)
+}
+
+async function saveMobileFollowUp() {
+  if (!activeMobileFollowUp.value) return
+  savingMobileFollowUp.value = true
+  try {
+    await logOutcome(
+      activeMobileFollowUp.value.name,
+      'Follow Up',
+      mobileFollowUpDate.value || null,
+      mobileFollowUpNote.value || null
+    )
+    activeMobileFollowUp.value = null
+  } finally {
+    savingMobileFollowUp.value = false
+  }
+}
+
+function formatPrice(val) {
+  if (!val) return '0'
+  const n = Number(val)
+  if (n >= 10000000) return (n / 10000000).toFixed(2) + ' Cr'
+  if (n >= 100000) return (n / 100000).toFixed(2) + ' L'
+  return n.toLocaleString('en-IN')
+}
+</script>
