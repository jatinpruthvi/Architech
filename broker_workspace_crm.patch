+        </Button>
+
+        <Button
+          variant="solid"
+          iconLeft="message-circle"
+          class="bg-green-600 hover:bg-green-700 text-white"
+          :disabled="!recipientPhone || recipientPhone.includes('•') || !messageBody"
+          @click="sendMessage"
+        >
+          {{ __('Send via WhatsApp') }}
+        </Button>
+      </div>
+    </div>
