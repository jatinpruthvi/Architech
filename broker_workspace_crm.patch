@@ -0,0 +1,22 @@
+# Copyright (c) 2026, Frappe Technologies Pvt. Ltd. and contributors
+# For license information, please see license.txt
+
+import frappe
+from frappe import _
+from frappe.model.document import Document
+
+
+class CRMRequirement(Document):
+	def validate(self):
+		self.set_requirement_title()
+
+	def set_requirement_title(self):
+		if not self.title:
+			parts = [
+				self.deal_type or _("Requirement"),
+				self.bhk if self.bhk != "Any" else None,
+				_("in") if self.preferred_locality else None,
+				self.preferred_locality or self.target_city,
+				f"- {self.client_name}" if self.client_name else None,
+			]
+			self.title = " ".join([p for p in parts if p]).strip()
