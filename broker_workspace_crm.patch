+      assert.ok(text.includes('🛋 *Furnishing:* Furnished'), 'Contains furnishing')
+      assert.ok(text.includes('💰 *Price / Rent:* ₹ 45,000'), 'Formats INR price with commas')
+      assert.ok(text.includes('🔑 *Availability:* Immediate'), 'Contains availability')
+      assert.ok(text.includes('Architech Broker Desk'), 'Includes desk signature')
+    })
