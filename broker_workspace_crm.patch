+import { defineStore } from 'pinia'
+import { createResource, call } from 'frappe-ui'
+import { computed, ref } from 'vue'
+
+export const brokerStore = defineStore('crm-broker', () => {
+  const kpis = createResource({
+    url: 'crm.api.broker.get_dashboard_kpis',
+    auto: true,
+  })
+
+  const queue = createResource({
+    url: 'crm.api.broker.get_calling_queue',
+    auto: true,
+  })
+
+  const urgentQueueCount = computed(() => {
+    return queue.data?.counts?.follow_ups || queue.data?.counts?.total || 0
+  })
+
+  const currentFilters = ref({
+    category: 'All',
+    bhk: 'Any',
+    property_type: 'Any',
+    furnishing: 'Any',
+    status: 'Available',
+    search: '',
+    page: 1,
+  })
+
+  function setFilters(newFilters) {
+    currentFilters.value = { ...currentFilters.value, ...newFilters }
+  }
+
+  function resetFilters() {
+    currentFilters.value = {
+      category: 'All',
+      bhk: 'Any',
+      property_type: 'Any',
+      furnishing: 'Any',
+      status: 'Available',
+      search: '',
+      page: 1,
+    }
+  }
+
+  async function revealContact(propertyId, channel = 'Desktop') {
+    const res = await call('crm.api.broker.reveal_owner_contact', {
+      property_id: propertyId,
+      channel,
+    })
+    kpis.reload()
+    return res
+  }
+
+  async function logOutcome(propertyId, outcome, followUpAt = null, note = null) {
+    const res = await call('crm.api.broker.log_call_outcome', {
+      property_id: propertyId,
+      outcome,
+      follow_up_at: followUpAt,
+      note,
+    })
+    queue.reload()
+    kpis.reload()
+    return res
+  }
+
+  async function toggleShortlist(propertyId) {
+    const res = await call('crm.api.broker.toggle_shortlist', {
+      property_id: propertyId,
+    })
+    return res
+  }
+
+  return {
+    kpis,
+    queue,
+    urgentQueueCount,
+    currentFilters,
+    setFilters,
+    resetFilters,
+    revealContact,
+    logOutcome,
+    toggleShortlist,
+  }
+})
