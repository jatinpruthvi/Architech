@@ -0,0 +1,29 @@
+# Copyright (c) 2026, Frappe Technologies Pvt. Ltd. and contributors
+# For license information, please see license.txt
+
+import frappe
+from frappe import _
+from frappe.model.document import Document
+
+
+class CRMProperty(Document):
+	def validate(self):
+		self.set_property_name()
+		self.extract_phone_last4()
+
+	def set_property_name(self):
+		if not self.property_name:
+			components = [
+				self.bhk or self.property_type or _("Property"),
+				_("in"),
+				self.premise_name or self.area or self.city or _("Location"),
+			]
+			self.property_name = " ".join([c for c in components if c]).strip()
+
+	def extract_phone_last4(self):
+		if self.owner_phone:
+			cleaned = "".join(filter(str.isdigit, str(self.owner_phone)))
+			if len(cleaned) >= 4:
+				self.owner_phone_last4 = cleaned[-4:]
+			else:
+				self.owner_phone_last4 = cleaned
