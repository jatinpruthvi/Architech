+<script setup>
+import { ref } from 'vue'
+import { createResource, Button } from 'frappe-ui'
+import { brokerStore } from '@/stores/broker'
+import WhatsAppModal from '@/components/Broker/WhatsAppModal.vue'
+import PropertyNoteModal from '@/components/Broker/PropertyNoteModal.vue'
+
+const props = defineProps({
+  propertyId: { type: String, required: true },
+})
+
+const { revealContact, logOutcome, toggleShortlist } = brokerStore()
+
+const revealing = ref(false)
+const loggingOutcome = ref(false)
+const selectedOutcome = ref(null)
+const showWhatsAppModal = ref(false)
+const showNoteModal = ref(false)
+
+const detail = createResource({
+  url: 'crm.api.broker.get_property_detail',
+  params: { property_id: props.propertyId },
+  auto: true,
+})
+
+const buyerMatches = createResource({
+  url: 'crm.api.matching.get_buyer_matches_for_property',
+  params: { property_id: props.propertyId, limit: 3 },
+  auto: true,
+})
+
+async function revealPhone() {
+  revealing.value = true
+  try {
+    await revealContact(props.propertyId, 'Mobile App')
+    detail.reload()
+  } finally {
+    revealing.value = false
+  }
+}
+
+async function submitMobileOutcome() {
+  if (!selectedOutcome.value) return
+  loggingOutcome.value = true
+  try {
+    await logOutcome(props.propertyId, selectedOutcome.value)
+    selectedOutcome.value = null
+    detail.reload()
+  } finally {
+    loggingOutcome.value = false
+  }
+}
+
+async function toggleShortlistCurrent() {
+  const res = await toggleShortlist(props.propertyId)
+  if (res && detail.data?.property) {
+    detail.data.property.shortlisted = res.shortlisted
+  }
+}
+
+function makeCall(phone) {
+  if (!phone) return
+  window.location.href = `tel:${phone.replace(/\s+/g, '')}`
+}
+
+function openWhatsApp(phone, title) {
+  if (!phone) return
+  const cleanPhone = phone.replace(/\D/g, '')
+  const msg = encodeURIComponent(`Hello, I am reaching out regarding ${title}.`)
+  window.open(`https://api.whatsapp.com/send?phone=${cleanPhone}&text=${msg}`, '_blank')
+}
+
+function formatPrice(val) {
+  if (!val) return '0'
+  const n = Number(val)
+  if (n >= 10000000) return (n / 10000000).toFixed(2) + ' Cr'
+  if (n >= 100000) return (n / 100000).toFixed(2) + ' L'
+  return n.toLocaleString('en-IN')
+}
+</script>
