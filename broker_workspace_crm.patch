+</template>
+
+<script setup>
+import { ref, watch } from 'vue'
+import { Button } from 'frappe-ui'
+import {
+  generatePropertyBrochure,
+  generateOwnerGreeting,
+  launchWhatsApp,
+} from '@/utils/whatsapp'
+
+const props = defineProps({
+  modelValue: { type: Boolean, default: false },
+  property: { type: Object, default: null },
+  phone: { type: String, default: '' },
+  clientName: { type: String, default: '' },
+})
+
+const emit = defineEmits(['update:modelValue'])
+
+const recipientPhone = ref(props.phone || '')
+const selectedTemplate = ref('brochure')
+const messageBody = ref('')
+
+watch(
+  () => props.modelValue,
+  (val) => {
+    if (val) {
+      recipientPhone.value = props.phone || props.property?.owner_phone || ''
+      setTemplate(selectedTemplate.value)
+    }
+  }
+)
+
+function setTemplate(type) {
+  selectedTemplate.value = type
+  if (type === 'brochure') {
+    messageBody.value = generatePropertyBrochure(props.property)
+  } else if (type === 'inquiry') {
+    messageBody.value = generateOwnerGreeting(props.property)
+  } else if (type === 'visit') {
+    const title = props.property?.property_name || 'the property'
+    messageBody.value = `Hello! Would you be available tomorrow between 11:00 AM and 4:00 PM for a site inspection of *${title}*? Please let me know what time works best for you.`
+  } else {
+    messageBody.value = `Hello, contacting you regarding ${props.property?.property_name || 'your real estate requirement'}.`
+  }
+}
+
+function close() {
+  emit('update:modelValue', false)
+}
+
+function sendMessage() {
+  launchWhatsApp(recipientPhone.value, messageBody.value)
+  close()
+}
+</script>
