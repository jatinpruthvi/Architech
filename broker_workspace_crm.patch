+<template>
+  <div
+    v-if="modelValue"
+    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40"
+    @click.self="close"
+  >
+    <div class="w-full max-w-sm bg-surface-white rounded-3xl p-5 border border-outline-gray-1 shadow-2xl space-y-3">
+      <div class="flex items-center justify-between pb-2 border-b border-outline-gray-1">
+        <div>
+          <h3 class="text-sm font-bold text-ink-gray-9">{{ __('Private Property Note') }}</h3>
+          <p class="text-[11px] text-ink-gray-5 truncate max-w-[200px]">{{ property?.property_name }}</p>
+        </div>
+        <button type="button" class="text-ink-gray-4 text-sm" @click="close">✕</button>
+      </div>
+
+      <div class="space-y-1 text-xs">
+        <textarea
+          v-model="noteText"
+          rows="4"
+          class="w-full p-2.5 text-xs rounded-xl border border-outline-gray-1 bg-surface-base focus:outline-none focus:ring-1 focus:ring-ink-gray-7"
+          placeholder="Add team note: key available with security; owner negotiable on rent..."
+        ></textarea>
+      </div>
+
+      <div class="flex items-center justify-end gap-2 pt-1">
+        <Button variant="subtle" size="sm" @click="close">{{ __('Cancel') }}</Button>
+        <Button variant="solid" size="sm" :loading="saving" @click="saveNote">{{ __('Save Note') }}</Button>
+      </div>
+    </div>
+  </div>
+</template>
+
+<script setup>
+import { ref, watch } from 'vue'
+import { call, Button } from 'frappe-ui'
+
+const props = defineProps({
+  modelValue: { type: Boolean, default: false },
+  property: { type: Object, default: null },
+})
+
+const emit = defineEmits(['update:modelValue', 'saved'])
+
+const noteText = ref('')
+const saving = ref(false)
+
+watch(
+  () => props.modelValue,
+  (val) => {
+    if (val) {
+      noteText.value = props.property?.latest_note || ''
+    }
+  }
+)
+
+function close() {
+  emit('update:modelValue', false)
+}
+
+async function saveNote() {
+  if (!props.property?.name) return
+  saving.value = true
+  try {
+    const res = await call('crm.api.broker.save_property_note', {
+      property_id: props.property.name,
+      note: noteText.value,
+    })
+    if (res?.ok) {
+      props.property.latest_note = noteText.value
+      emit('saved', noteText.value)
+      close()
+    }
+  } finally {
+    saving.value = false
+  }
+}
+</script>
