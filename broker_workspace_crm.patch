@@ -0,0 +1,94 @@
+/**
+ * Real-Estate WhatsApp Utilities for Frappe CRM & Mobile App
+ */
+
+/**
+ * Normalizes phone numbers to standard international format (defaults to India +91).
+ */
+export function normalizePhoneForWhatsApp(rawPhone) {
+  if (!rawPhone) return ''
+  const digits = String(rawPhone).replace(/\D/g, '')
+  if (digits.length === 10) {
+    return '91' + digits
+  }
+  if (digits.length === 12 && digits.startsWith('91')) {
+    return digits
+  }
+  return digits
+}
+
+/**
+ * Generates formatted Real-Estate Property Brochure for WhatsApp.
+ */
+export function generatePropertyBrochure(property) {
+  if (!property) return ''
+  const name = property.property_name || 'Property'
+  const loc = [property.premise_name, property.area, property.city].filter(Boolean).join(', ')
+  const bhk = property.bhk || property.property_type || 'Residential'
+  const sqft = property.super_builtup_area ? `${property.super_builtup_area} sq ft` : null
+  const furnish = property.furnishing || 'Unfurnished'
+  const price = property.price ? `₹ ${Number(property.price).toLocaleString('en-IN')}` : 'Price on Request'
+  const avail = property.availability || 'Immediate'
+
+  let text = `*🏡 ${name}*\n\n`
+  text += `📍 *Location:* ${loc}\n`
+  text += `📐 *Configuration:* ${bhk}${sqft ? ' | ' + sqft : ''}\n`
+  text += `🛋 *Furnishing:* ${furnish}\n`
+  text += `💰 *Price / Rent:* ${price}\n`
+  text += `🔑 *Availability:* ${avail}\n\n`
+  text += `Would you like to schedule a site visit or review further details? Let me know!\n`
+  text += `— _Sent via Architech Broker Desk_`
+
+  return text
+}
+
+/**
+ * Generates owner listing inquiry / availability check text.
+ */
+export function generateOwnerGreeting(property) {
+  if (!property) return ''
+  const owner = property.owner_name || 'Owner'
+  const name = property.property_name || 'your property'
+  const area = property.area || 'your locality'
+  const cat = property.category?.includes('Rent') ? 'rent' : 'sale'
+
+  return `Hello ${owner}, I am contacting you from the Architech Broker Desk regarding your listing for *${name}* in *${area}*. Is this property still available for ${cat}? We have interested clients looking for immediate options.`
+}
+
+/**
+ * Generates buyer match summary text.
+ */
+export function generateBuyerMatchGreeting(clientName, matchedProperties = []) {
+  const name = clientName || 'Client'
+  let text = `Hello ${name}, based on your requirement, here are matching verified properties available right now:\n\n`
+
+  matchedProperties.slice(0, 3).forEach((p, idx) => {
+    const price = p.price ? `₹ ${Number(p.price).toLocaleString('en-IN')}` : ''
+    text += `${idx + 1}. *${p.property_name}* (${p.bhk || 'Property'})\n`
+    text += `   📍 ${p.area || p.city} · ${price}\n\n`
+  })
+
+  text += `Please let me know which option you'd like to inspect and I will arrange the visit.\n`
+  text += `— _Architech Broker Desk_`
+  return text
+}
+
+/**
+ * Launches WhatsApp across Mobile App, PWA, and Desktop Browser.
+ */
+export function launchWhatsApp(phone, messageText) {
+  const cleanPhone = normalizePhoneForWhatsApp(phone)
+  const encoded = encodeURIComponent(messageText || '')
+
+  const isMobile =
+    typeof window !== 'undefined' &&
+    (/Android|iPhone|iPad|iPod/i.test(navigator.userAgent) || window.innerWidth < 768)
+
+  if (isMobile) {
+    // Hand off to native WhatsApp app on Android/iOS
+    window.location.href = `https://api.whatsapp.com/send?phone=${cleanPhone}&text=${encoded}`
+  } else {
+    // Desktop Web WhatsApp
+    window.open(`https://web.whatsapp.com/send?phone=${cleanPhone}&text=${encoded}`, '_blank')
+  }
+}
