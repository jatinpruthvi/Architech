+# Copyright (c) 2026, Frappe Technologies Pvt. Ltd. and Contributors
+# See license.txt
+
+import sys
+import unittest
+from unittest.mock import MagicMock
+
+# Mock frappe if not running within a live Frappe bench environment
+class MockDocument:
+	def __init__(self, d=None):
+		if d and isinstance(d, dict):
+			for k, v in d.items():
+				setattr(self, k, v)
+
+if "frappe" not in sys.modules:
+	frappe_mock = MagicMock()
+	frappe_mock._ = lambda x: str(x)
+	sys.modules["frappe"] = frappe_mock
+	sys.modules["frappe.utils"] = MagicMock()
+	sys.modules["frappe.core"] = MagicMock()
+	sys.modules["frappe.core.api"] = MagicMock()
+	sys.modules["frappe.core.api.file"] = MagicMock()
+	sys.modules["frappe.rate_limiter"] = MagicMock()
+	sys.modules["frappe.translate"] = MagicMock()
+	doc_mock = MagicMock()
+	doc_mock.Document = MockDocument
+	sys.modules["frappe.model"] = doc_mock
+	sys.modules["frappe.model.document"] = doc_mock
+	sys.modules["crm.utils"] = MagicMock()
+if "bs4" not in sys.modules:
+	sys.modules["bs4"] = MagicMock()
+
+from crm.api.broker import mask_phone
+from crm.fcrm.doctype.crm_property.crm_property import CRMProperty
+from crm.fcrm.doctype.crm_requirement.crm_requirement import CRMRequirement
+
+
+class TestBrokerAPI(unittest.TestCase):
+	def test_mask_phone_with_full_number(self):
+		phone = "+91 98765 43210"
+		masked = mask_phone(phone)
+		self.assertEqual(masked, "+91 ••••• •3210")
+
+	def test_mask_phone_with_last4(self):
+		masked = mask_phone(None, last4="4306")
+		self.assertEqual(masked, "+91 ••••• •4306")
+
+	def test_mask_phone_empty(self):
+		masked = mask_phone(None, None)
+		self.assertEqual(masked, "••••••••••")
+
+	def test_property_last4_extraction(self):
+		doc = CRMProperty({"doctype": "CRM Property"})
+		doc.owner_phone = "+91 91234 56789"
+		doc.extract_phone_last4()
+		self.assertEqual(doc.owner_phone_last4, "6789")
+
+	def test_property_title_auto_generation(self):
+		doc = CRMProperty({"doctype": "CRM Property"})
+		doc.property_name = None
+		doc.bhk = "3 BHK"
+		doc.premise_name = "Satyam Complex"
+		doc.area = "Bodakdev"
+		doc.set_property_name()
+		self.assertIn("3 BHK", doc.property_name)
+		self.assertIn("Satyam Complex", doc.property_name)
+
+	def test_requirement_title_auto_generation(self):
+		doc = CRMRequirement({"doctype": "CRM Requirement"})
+		doc.title = None
+		doc.deal_type = "Rent"
+		doc.bhk = "2 BHK"
+		doc.preferred_locality = "Satellite"
+		doc.client_name = "Amit Patel"
+		doc.set_requirement_title()
+		self.assertIn("Rent", doc.title)
+		self.assertIn("2 BHK", doc.title)
+		self.assertIn("Satellite", doc.title)
+		self.assertIn("Amit Patel", doc.title)
+
+
+if __name__ == "__main__":
+	unittest.main()
