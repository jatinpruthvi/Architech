+	def test_doctype_json_schema_validity(self):
+		"""Verify all 3 DocType JSON definitions strictly follow Frappe metadata specifications."""
+		doctypes = [
+			"crm_property/crm_property.json",
+			"crm_requirement/crm_requirement.json",
+			"crm_contact_reveal_log/crm_contact_reveal_log.json",
+		]
+
+		valid_fieldtypes = {
+			"Data", "Select", "Currency", "Float", "Int", "Check", "Small Text",
+			"Text Editor", "Datetime", "Link", "Column Break", "Section Break", "Attach Image"
+		}
+
+		for dt_rel in doctypes:
+			dt_path = os.path.join(self.crm_dir, "fcrm", "doctype", dt_rel)
+			self.assertTrue(os.path.exists(dt_path), f"DocType JSON missing: {dt_path}")
+
+			with open(dt_path, "r", encoding="utf-8") as f:
+				meta = json.load(f)
+
+			# 1. Base metadata checks
+			self.assertEqual(meta.get("doctype"), "DocType")
+			self.assertEqual(meta.get("module"), "FCRM")
+			self.assertIn("name", meta)
+			self.assertTrue(meta.get("permissions"), f"Missing permissions for {dt_rel}")
+
+			# 2. Permissions check: System Manager, Sales Manager, Sales User
+			roles = [p.get("role") for p in meta["permissions"]]
+			self.assertIn("System Manager", roles)
+			self.assertIn("Sales Manager", roles)
+			self.assertIn("Sales User", roles)
+
+			# 3. Field validation
+			field_names = set()
+			for field in meta.get("fields", []):
+				fname = field.get("fieldname")
+				ftype = field.get("fieldtype")
+
+				self.assertIn(ftype, valid_fieldtypes, f"Invalid fieldtype '{ftype}' in {dt_rel} for field '{fname}'")
+				self.assertTrue(fname, f"Empty fieldname in {dt_rel}")
+				self.assertNotIn(fname, field_names, f"Duplicate fieldname '{fname}' in {dt_rel}")
+				field_names.add(fname)
+
+				# Select fields must have options
+				if ftype == "Select":
+					self.assertTrue(field.get("options"), f"Select field '{fname}' in {dt_rel} has no options")
+
+				# Link fields must specify target doctype
