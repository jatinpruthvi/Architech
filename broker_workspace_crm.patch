+import { ref, computed } from 'vue'
+import { Button } from 'frappe-ui'
+import { brokerStore } from '@/stores/broker'
+import WhatsAppModal from '@/components/Broker/WhatsAppModal.vue'
+
+const { queue, logOutcome, revealContact } = brokerStore()
+
+const activeFilter = ref('all')
+const activeFollowUpItem = ref(null)
+const scheduledIso = ref('')
+const scheduledNote = ref('')
+const savingOutcome = ref(false)
+const showWhatsAppModal = ref(false)
+const activeWhatsAppProperty = ref(null)
+
+const filterChips = [
+  { key: 'all', label: 'All Contacts' },
+  { key: 'follow_up', label: 'Callbacks Due' },
+  { key: 'fresh', label: 'Fresh' },
+  { key: 'retry', label: 'No Answer' },
+]
+
+const followUpPresets = [
+  { label: 'Tomorrow 9:30 AM', offsetDays: 1, hour: 9, minute: 30 },
+  { label: 'In 2 Days', offsetDays: 2, hour: 10, minute: 0 },
+  { label: 'Next Week', offsetDays: 7, hour: 10, minute: 0 },
+]
+
+const filteredQueue = computed(() => {
+  const list = queue.data?.queue || []
+  if (activeFilter.value === 'follow_up') {
+    return list.filter((i) => i.current_outcome === 'Follow Up')
+  }
+  if (activeFilter.value === 'fresh') {
+    return list.filter((i) => !i.last_call_at)
+  }
+  if (activeFilter.value === 'retry') {
+    return list.filter((i) => i.current_outcome === 'No Answer')
+  }
+  return list
+})
+
+function setPreset(days, hour, minute) {
+  const d = new Date(Date.now() + days * 86400000)
+  d.setHours(hour, minute, 0, 0)
+  scheduledIso.value = d.toISOString().slice(0, 16)
+}
+
+function openFollowUpDialog(item) {
+  activeFollowUpItem.value = item
+  setPreset(1, 9, 30)
+  scheduledNote.value = ''
+}
+
+async function confirmFollowUp() {
+  if (!activeFollowUpItem.value) return
+  savingOutcome.value = true
+  try {
+    await logOutcome(
+      activeFollowUpItem.value.name,
+      'Follow Up',
+      scheduledIso.value || null,
+      scheduledNote.value || null
+    )
+    activeFollowUpItem.value = null
+  } finally {
+    savingOutcome.value = false
+  }
+}
+
+async function recordFastOutcome(item, outcome) {
+  await logOutcome(item.name, outcome)
+}
+
+async function handleReveal(item) {
+  const res = await revealContact(item.name, 'Desktop')
+  if (res?.ok) {
+    item.revealed = true
+    item.owner_phone = res.owner_phone
+  }
+}
+
+function dial(phone, item) {
+  if (!phone) return
+  window.location.href = `tel:${phone.replace(/\s+/g, '')}`
+}
+
+function openWhatsApp(item) {
+  activeWhatsAppProperty.value = item
+  showWhatsAppModal.value = true
+}
+</script>
