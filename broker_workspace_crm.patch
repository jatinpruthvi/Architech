+import QuickRequirementModal from '@/components/Broker/QuickRequirementModal.vue'
+
+const store = brokerStore()
+const { kpis, queue, logOutcome, revealContact } = store
+
+const showPropertyModal = ref(false)
+const showRequirementModal = ref(false)
+
+async function handleRevealDesktop(item) {
+  const res = await revealContact(item.name, 'Desktop')
+  if (res?.ok) {
+    item.revealed = true
+    item.owner_phone = res.owner_phone
+  }
+}
+
+const categoryTiles = [
+  { key: 'Residential Rent', label: 'Res. Rent', icon: 'home' },
+  { key: 'Residential Sell', label: 'Res. Sell', icon: 'key' },
+  { key: 'Commercial Rent', label: 'Comm. Rent', icon: 'briefcase' },
+  { key: 'Commercial Sell', label: 'Comm. Sell', icon: 'building' },
+]
+
+function getCatCount(catKey) {
+  const match = kpis.data?.by_category?.find((c) => c.category === catKey)
+  return match ? match.count : 0
+}
+
+const outcomeStats = computed(() => {
+  return kpis.data?.outcome_counts || {
+    Connected: 0,
+    'No Answer': 0,
+    'Follow Up': 0,
+    Deal: 0,
+  }
+})
+
+function outcomeColor(outcome) {
+  switch (outcome) {
+    case 'Connected':
+      return 'bg-green-500'
+    case 'Deal':
+      return 'bg-purple-600'
+    case 'Follow Up':
+      return 'bg-amber-500'
+    case 'No Answer':
+      return 'bg-gray-400'
+    default:
+      return 'bg-rose-500'
+  }
+}
+
+function dial(phone) {
+  if (!phone) return
+  window.location.href = `tel:${phone.replace(/\s+/g, '')}`
+}
+
+async function quickOutcome(propertyId, outcome) {
+  await logOutcome(propertyId, outcome)
+}
+
+function refreshAll() {
+  kpis.reload()
+  queue.reload()
+}
+
+function openNewProperty() {
+  window.location.href = '/crm/new/CRM%20Property'
+}
+
+function openNewRequirement() {
+  window.location.href = '/crm/new/CRM%20Requirement'
+}
+</script>
