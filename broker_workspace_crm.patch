+# Copyright (c) 2026, Frappe Technologies Pvt. Ltd. and contributors
+# For license information, please see license.txt
+
+from datetime import datetime, timedelta
+from typing import Any, Optional
+
+import frappe
+from frappe import _
+from frappe.utils import cint, flt, getdate, now_datetime
+
+
+def check_broker_permission():
+	if frappe.session.user == "Guest":
+		frappe.throw(_("Authentication required to access Broker Workspace"), frappe.AuthenticationError)
+
+
+def mask_phone(phone: Optional[str], last4: Optional[str] = None) -> str:
+	if not phone and not last4:
+		return "••••••••••"
+	last_digits = last4 or ("".join(filter(str.isdigit, str(phone)))[-4:] if phone else "••••")
+	return f"+91 ••••• •{last_digits}"
+
+
+@frappe.whitelist()
+def get_dashboard_kpis() -> dict[str, Any]:
+	check_broker_permission()
+
+	today_start = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0)
+	yesterday_start = today_start - timedelta(days=1)
+
+	# Active properties
+	active_properties = frappe.db.count("CRM Property", {"status": "Available"})
+	today_properties = frappe.db.count("CRM Property", {"creation": [">=", today_start]})
+	yesterday_properties = frappe.db.count(
+		"CRM Property", {"creation": ["between", [yesterday_start, today_start]]}
+	)
+
+	# Requirements
+	active_requirements = frappe.db.count("CRM Requirement", {"status": "Active"})
+	today_requirements = frappe.db.count("CRM Requirement", {"creation": [">=", today_start]})
+
+	# Calling queue metrics
+	now = now_datetime()
+	follow_up_due = frappe.db.count(
+		"CRM Property",
+		{"status": "Available", "current_outcome": "Follow Up", "follow_up_at": ["<=", now]},
+	)
+	uncalled_fresh = frappe.db.count(
+		"CRM Property",
+		{"status": "Available", "last_call_at": ("is", "not set")},
+	)
+	queue_total = follow_up_due + uncalled_fresh
+
+	# Unrevealed contacts count
+	unrevealed_count = frappe.db.count(
+		"CRM Property",
+		{"status": "Available", "contact_revealed": 0},
+	)
+
+	# Category breakdown
+	categories = [
+		"Residential Rent",
+		"Residential Sell",
+		"Commercial Rent",
+		"Commercial Sell",
+	]
+
+	by_category = []
+	for cat in categories:
+		cat_count = frappe.db.count("CRM Property", {"status": "Available", "category": cat})
+		by_category.append({"category": cat, "count": cat_count})
+
+	# Recent outcomes summary
+	outcomes = ["Connected", "No Answer", "Wrong Number", "Follow Up", "Deal"]
+	outcome_counts = {}
+	for oc in outcomes:
+		outcome_counts[oc] = frappe.db.count("CRM Property", {"current_outcome": oc})
+
+	return {
+		"owner": {
+			"active": active_properties,
+			"today": today_properties,
+			"yesterday": yesterday_properties,
+		},
+		"requirements": {
+			"active": active_requirements,
+			"today": today_requirements,
+		},
+		"calling_queue": {
+			"total": queue_total,
+			"follow_up_due": follow_up_due,
+			"uncalled_fresh": uncalled_fresh,
+		},
+		"unrevealed_count": unrevealed_count,
+		"by_category": by_category,
+		"outcome_counts": outcome_counts,
+	}
+
+
+@frappe.whitelist()
+def get_properties(
+	category: Optional[str] = None,
+	bhk: Optional[str] = None,
+	property_type: Optional[str] = None,
+	furnishing: Optional[str] = None,
+	min_price: Optional[float] = None,
+	max_price: Optional[float] = None,
+	area: Optional[str] = None,
+	city: Optional[str] = None,
+	status: Optional[str] = None,
+	listing_type: Optional[str] = None,
+	is_premium: Optional[int] = None,
+	shortlisted: Optional[int] = None,
+	search: Optional[str] = None,
+	sort_by: str = "modified",
+	sort_order: str = "desc",
+	page: int = 1,
+	limit: int = 25,
+) -> dict[str, Any]:
+	check_broker_permission()
+
+	page = max(1, cint(page))
+	limit = min(100, max(1, cint(limit)))
+	offset = (page - 1) * limit
+
+	filters: dict[str, Any] = {}
+	if category and category != "All":
+		filters["category"] = category
+	if bhk and bhk != "Any":
+		filters["bhk"] = bhk
+	if property_type and property_type != "Any":
+		filters["property_type"] = property_type
+	if furnishing and furnishing != "Any":
+		filters["furnishing"] = furnishing
+	if area:
+		filters["area"] = ["like", f"%{area}%"]
+	if city:
+		filters["city"] = city
+	if status and status != "All":
+		filters["status"] = status
+	if listing_type and listing_type != "All":
+		filters["listing_type"] = listing_type
+	if is_premium is not None and str(is_premium) != "":
+		filters["is_premium"] = cint(is_premium)
+	if shortlisted is not None and str(shortlisted) != "":
+		filters["shortlisted"] = cint(shortlisted)
+
+	if min_price is not None and flt(min_price) > 0:
+		filters["price"] = [">=", flt(min_price)]
+	if max_price is not None and flt(max_price) > 0:
+		if "price" in filters:
+			filters["price"] = ["between", [flt(min_price or 0), flt(max_price)]]
+		else:
+			filters["price"] = ["<=", flt(max_price)]
+
+	if search:
+		filters["property_name"] = ["like", f"%{search}%"]
+
+	fields = [
+		"name",
+		"property_name",
+		"category",
+		"listing_type",
+		"property_type",
+		"bhk",
+		"status",
+		"is_premium",
+		"shortlisted",
+		"image",
+		"price",
+		"super_builtup_area",
+		"carpet_area",
+		"furnishing",
+		"availability",
+		"premise_name",
+		"area",
+		"city",
+		"pincode",
+		"owner_name",
+		"owner_phone",
+		"owner_phone_last4",
+		"contact_revealed",
+		"reveal_count",
+		"current_outcome",
+		"last_call_at",
+		"follow_up_at",
+		"total_calls",
+		"latest_note",
+		"creation",
+		"modified",
+	]
+
+	order_by = f"{sort_by} {sort_order}"
+
+	total = frappe.db.count("CRM Property", filters)
+	rows = frappe.db.get_list(
+		"CRM Property",
+		filters=filters,
+		fields=fields,
+		order_by=order_by,
+		start=offset,
+		page_length=limit,
+	)
+
+	# Fetch revealed properties for the current user
+	user_reveals = set(
+		frappe.db.get_all(
+			"CRM Contact Reveal Log",
+			filters={"user": frappe.session.user},
+			pluck="property",
+		)
+	)
+
+	# Process rows to enforce phone masking
+	for r in rows:
+		is_revealed = (r.name in user_reveals) or r.contact_revealed
+		if is_revealed:
+			r["revealed"] = True
+		else:
+			r["revealed"] = False
+			r["owner_phone"] = mask_phone(r.get("owner_phone"), r.get("owner_phone_last4"))
+
+	return {
+		"data": rows,
+		"total": total,
+		"page": page,
+		"limit": limit,
+		"total_pages": (total + limit - 1) // limit if limit else 1,
+	}
+
+
+@frappe.whitelist()
+def get_property_detail(property_id: str) -> dict[str, Any]:
+	check_broker_permission()
+
+	if not frappe.db.exists("CRM Property", property_id):
+		frappe.throw(_("Property not found: {0}").format(property_id), frappe.DoesNotExistError)
+
+	doc = frappe.get_doc("CRM Property", property_id)
+
+	# Check if current user has revealed this contact
+	is_revealed = frappe.db.exists(
+		"CRM Contact Reveal Log",
+		{"property": property_id, "user": frappe.session.user},
+	) or doc.contact_revealed
+
+	doc_dict = doc.as_dict()
+	doc_dict["revealed"] = bool(is_revealed)
+	if not is_revealed:
+		doc_dict["owner_phone"] = mask_phone(doc.owner_phone, doc.owner_phone_last4)
+
+	# Linked call logs
+	call_logs = frappe.db.get_list(
+		"CRM Call Log",
+		filters={"reference_doctype": "CRM Property", "reference_docname": property_id},
+		fields=["name", "status", "type", "start_time", "duration", "caller", "note"],
+		order_by="start_time desc",
+		limit=10,
+	)
+
+	# Linked tasks
+	tasks = frappe.db.get_list(
+		"CRM Task",
+		filters={"reference_doctype": "CRM Property", "reference_docname": property_id},
+		fields=["name", "title", "status", "priority", "due_date", "assigned_to"],
+		order_by="due_date asc",
+		limit=10,
+	)
+
+	return {
+		"property": doc_dict,
+		"call_logs": call_logs,
+		"tasks": tasks,
+	}
+
+
+@frappe.whitelist()
+def reveal_owner_contact(property_id: str, channel: str = "Desktop") -> dict[str, Any]:
+	check_broker_permission()
+
+	if not frappe.db.exists("CRM Property", property_id):
+		frappe.throw(_("Property not found: {0}").format(property_id), frappe.DoesNotExistError)
+
+	doc = frappe.get_doc("CRM Property", property_id)
+
+	# Daily quota check: 50 reveals per user per day
+	today_start = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0)
+	daily_reveals = frappe.db.count(
+		"CRM Contact Reveal Log",
+		{"user": frappe.session.user, "revealed_at": [">=", today_start]},
+	)
+
+	DAILY_LIMIT = 100
+	if daily_reveals >= DAILY_LIMIT:
+		frappe.throw(
+			_("Daily contact reveal limit of {0} reached. Please contact your manager.").format(DAILY_LIMIT),
+			frappe.PermissionError,
+		)
+
+	ip = getattr(frappe.local, "request_ip", None)
+	ua = None
+	if hasattr(frappe, "request") and frappe.request:
+		ua = frappe.request.headers.get("User-Agent")
+
+	reveal_log = frappe.get_doc({
+		"doctype": "CRM Contact Reveal Log",
+		"property": property_id,
+		"user": frappe.session.user,
+		"revealed_at": now_datetime(),
+		"channel": channel,
+		"owner_phone_revealed": doc.owner_phone,
+		"ip_address": ip,
+		"user_agent": ua,
+	})
+	reveal_log.insert(ignore_permissions=True)
+
+	doc.contact_revealed = 1
+	doc.reveal_count = cint(doc.reveal_count) + 1
+	doc.save(ignore_permissions=True)
+
+	return {
+		"ok": True,
+		"property_id": property_id,
+		"owner_phone": doc.owner_phone,
+		"revealed": True,
+		"reveal_count": doc.reveal_count,
+		"remaining_daily_reveals": max(0, DAILY_LIMIT - (daily_reveals + 1)),
+	}
+
+
+@frappe.whitelist()
+def log_call_outcome(
+	property_id: str,
+	outcome: str,
+	follow_up_at: Optional[str] = None,
+	note: Optional[str] = None,
+	duration: Optional[int] = None,
+) -> dict[str, Any]:
+	check_broker_permission()
+
+	valid_outcomes = ["Connected", "No Answer", "Wrong Number", "Follow Up", "Deal"]
+	if outcome not in valid_outcomes:
+		frappe.throw(_("Invalid call outcome: {0}").format(outcome))
+
+	if not frappe.db.exists("CRM Property", property_id):
+		frappe.throw(_("Property not found: {0}").format(property_id), frappe.DoesNotExistError)
+
+	doc = frappe.get_doc("CRM Property", property_id)
+	now = now_datetime()
+
+	doc.current_outcome = outcome
+	doc.last_call_at = now
+	doc.total_calls = cint(doc.total_calls) + 1
+
+	if outcome == "Follow Up" and follow_up_at:
+		doc.follow_up_at = follow_up_at
+	elif outcome != "Follow Up":
+		doc.follow_up_at = None
+
+	if outcome == "Deal":
+		doc.status = "Under Negotiation"
+
+	if note:
+		doc.latest_note = note
+
+	doc.save(ignore_permissions=True)
+
+	# 1. Create CRM Call Log
+	call_status_map = {
+		"Connected": "Completed",
+		"No Answer": "No Answer",
+		"Wrong Number": "Failed",
+		"Follow Up": "Completed",
+		"Deal": "Completed",
+	}
+
+	user_phone = frappe.db.get_value("User", frappe.session.user, "mobile_no") or "Broker Desk"
+	target_phone = doc.owner_phone or doc.owner_phone_last4 or "Unknown"
+
+	call_log = frappe.get_doc({
+		"doctype": "CRM Call Log",
+		"id": frappe.generate_hash(length=12),
+		"reference_doctype": "CRM Property",
+		"reference_docname": property_id,
+		"from": user_phone,
+		"to": target_phone,
+		"status": call_status_map.get(outcome, "Completed"),
+		"type": "Outgoing",
+		"caller": frappe.session.user,
+		"start_time": now,
+		"duration": cint(duration) if duration else 0,
+		"telephony_medium": "Manual",
+	})
+	call_log.insert(ignore_permissions=True)
+
+	# 2. Attach FCRM Note if note provided
+	if note:
+		fcrm_note = frappe.get_doc({
+			"doctype": "FCRM Note",
+			"title": f"Call Note: {outcome} ({doc.property_name})",
+			"content": note,
+			"reference_doctype": "CRM Property",
+			"reference_docname": property_id,
+		})
+		fcrm_note.insert(ignore_permissions=True)
+		call_log.note = fcrm_note.name
+		call_log.save(ignore_permissions=True)
+
+	# 3. Create CRM Task if follow up requested
+	if outcome == "Follow Up" and follow_up_at:
+		task = frappe.get_doc({
+			"doctype": "CRM Task",
+			"title": f"Follow-up: {doc.property_name}",
+			"reference_doctype": "CRM Property",
+			"reference_docname": property_id,
+			"assigned_to": frappe.session.user,
+			"status": "Todo",
+			"due_date": follow_up_at,
+			"priority": "High",
+			"description": f"Scheduled callback for property: {doc.property_name}.\nNote: {note or 'Follow-up call'}",
+		})
+		task.insert(ignore_permissions=True)
+
+	return {
+		"ok": True,
+		"property_id": property_id,
+		"outcome": outcome,
+		"call_log": call_log.name,
+	}
+
+
+@frappe.whitelist()
+def get_calling_queue(limit: int = 50) -> dict[str, Any]:
+	check_broker_permission()
+	limit = min(100, cint(limit) or 50)
+	now = now_datetime()
+
+	# 1. Overdue / Due follow-ups
+	follow_ups = frappe.db.get_list(
+		"CRM Property",
+		filters={"status": "Available", "current_outcome": "Follow Up", "follow_up_at": ["<=", now]},
+		fields=[
+			"name",
+			"property_name",
+			"category",
+			"bhk",
+			"price",
+			"area",
+			"city",
+			"owner_name",
+			"owner_phone",
+			"owner_phone_last4",
+			"contact_revealed",
+			"current_outcome",
+			"last_call_at",
+			"follow_up_at",
+			"latest_note",
+		],
+		order_by="follow_up_at asc",
+		limit=limit,
+	)
+
+	# 2. Fresh uncalled properties
+	needed = limit - len(follow_ups)
+	fresh_properties = []
+	if needed > 0:
+		fresh_properties = frappe.db.get_list(
+			"CRM Property",
+			filters={"status": "Available", "last_call_at": ("is", "not set")},
+			fields=[
+				"name",
+				"property_name",
+				"category",
+				"bhk",
+				"price",
+				"area",
+				"city",
+				"owner_name",
+				"owner_phone",
+				"owner_phone_last4",
+				"contact_revealed",
+				"current_outcome",
+				"last_call_at",
+				"follow_up_at",
+				"latest_note",
+			],
+			order_by="creation desc",
+			limit=needed,
+		)
+
+	# 3. Retries (No Answer)
+	needed = limit - len(follow_ups) - len(fresh_properties)
+	retries = []
+	if needed > 0:
+		retries = frappe.db.get_list(
+			"CRM Property",
+			filters={"status": "Available", "current_outcome": "No Answer"},
+			fields=[
+				"name",
+				"property_name",
+				"category",
+				"bhk",
+				"price",
+				"area",
+				"city",
+				"owner_name",
+				"owner_phone",
+				"owner_phone_last4",
+				"contact_revealed",
+				"current_outcome",
+				"last_call_at",
+				"follow_up_at",
+				"latest_note",
+			],
+			order_by="last_call_at asc",
+			limit=needed,
+		)
+
+	all_queue = follow_ups + fresh_properties + retries
+
+	# Check revealed status for current user
+	user_reveals = set(
+		frappe.db.get_all(
+			"CRM Contact Reveal Log",
+			filters={"user": frappe.session.user},
+			pluck="property",
+		)
+	)
+
+	for item in all_queue:
+		is_revealed = (item.name in user_reveals) or item.contact_revealed
+		item["revealed"] = bool(is_revealed)
+		if not is_revealed:
+			item["owner_phone"] = mask_phone(item.get("owner_phone"), item.get("owner_phone_last4"))
+
+	return {
+		"queue": all_queue,
+		"counts": {
+			"follow_ups": len(follow_ups),
+			"fresh": len(fresh_properties),
+			"retries": len(retries),
+			"total": len(all_queue),
+		},
+	}
+
+
+@frappe.whitelist()
+def toggle_shortlist(property_id: str) -> dict[str, Any]:
+	check_broker_permission()
+
+	if not frappe.db.exists("CRM Property", property_id):
+		frappe.throw(_("Property not found: {0}").format(property_id), frappe.DoesNotExistError)
+
+	current = cint(frappe.db.get_value("CRM Property", property_id, "shortlisted"))
+	next_val = 0 if current else 1
+	frappe.db.set_value("CRM Property", property_id, "shortlisted", next_val)
+
+	return {"property_id": property_id, "shortlisted": bool(next_val)}
+
+
+@frappe.whitelist()
+def get_requirements(
+	category: Optional[str] = None,
+	deal_type: Optional[str] = None,
+	status: Optional[str] = None,
+	bhk: Optional[str] = None,
+	search: Optional[str] = None,
+	page: int = 1,
+	limit: int = 25,
+) -> dict[str, Any]:
+	check_broker_permission()
+
+	page = max(1, cint(page))
+	limit = min(100, max(1, cint(limit)))
+	offset = (page - 1) * limit
+
+	filters: dict[str, Any] = {}
+	if category and category != "All":
+		filters["category"] = category
+	if deal_type and deal_type != "All":
+		filters["deal_type"] = deal_type
+	if status and status != "All":
+		filters["status"] = status
+	if bhk and bhk != "Any":
+		filters["bhk"] = bhk
+	if search:
+		filters["title"] = ["like", f"%{search}%"]
+
+	fields = [
+		"name",
+		"title",
+		"client_name",
+		"client_phone",
+		"client_email",
+		"deal_type",
+		"category",
+		"status",
+		"priority",
+		"bhk",
+		"property_type",
+		"furnishing",
+		"budget_min",
+		"budget_max",
+		"preferred_locality",
+		"target_city",
+		"timeline",
+		"matched_count",
+		"creation",
+		"modified",
+	]
+
+	total = frappe.db.count("CRM Requirement", filters)
+	rows = frappe.db.get_list(
+		"CRM Requirement",
+		filters=filters,
+		fields=fields,
+		order_by="modified desc",
+		start=offset,
+		page_length=limit,
+	)
+
+	return {
+		"data": rows,
+		"total": total,
+		"page": page,
+		"limit": limit,
+		"total_pages": (total + limit - 1) // limit if limit else 1,
+	}
+
+
+@frappe.whitelist()
+def create_quick_property(
+	property_name: str,
+	category: str,
+	listing_type: str = "Owner",
+	property_type: str = "Apartment",
+	bhk: str = "2 BHK",
+	price: float = 0,
+	area: str = "",
+	city: str = "Ahmedabad",
+	premise_name: Optional[str] = None,
+	owner_name: Optional[str] = None,
+	owner_phone: str = "",
+	furnishing: str = "Unfurnished",
+	availability: str = "Immediate",
+	super_builtup_area: Optional[float] = None,
+	description: Optional[str] = None,
+) -> dict[str, Any]:
+	check_broker_permission()
+
+	if not property_name or not area or not owner_phone:
+		frappe.throw(_("Title, Area, and Owner Phone are required."))
+
+	doc = frappe.get_doc({
+		"doctype": "CRM Property",
+		"property_name": property_name.strip(),
+		"category": category,
+		"listing_type": listing_type,
+		"property_type": property_type,
+		"bhk": bhk,
+		"price": flt(price),
+		"area": area.strip(),
+		"city": city.strip(),
+		"premise_name": premise_name.strip() if premise_name else None,
+		"owner_name": owner_name.strip() if owner_name else "Owner",
+		"owner_phone": owner_phone.strip(),
+		"furnishing": furnishing,
+		"availability": availability,
+		"super_builtup_area": flt(super_builtup_area) if super_builtup_area else None,
+		"description": description,
+		"status": "Available",
+	})
+	doc.insert()
+
+	return {"ok": True, "property": doc.as_dict()}
+
+
+@frappe.whitelist()
+def create_quick_requirement(
+	client_name: str,
+	client_phone: str,
+	deal_type: str = "Rent",
+	category: str = "Residential Rent",
+	bhk: str = "2 BHK",
+	budget_max: float = 0,
+	preferred_locality: str = "",
+	target_city: str = "Ahmedabad",
+	furnishing: str = "Any",
+	timeline: str = "Immediate",
+	notes: Optional[str] = None,
+) -> dict[str, Any]:
+	check_broker_permission()
+
+	if not client_name or not client_phone or not preferred_locality:
+		frappe.throw(_("Client Name, Phone, and Preferred Locality are required."))
+
+	req_title = f"{client_name.strip()} ({bhk} in {preferred_locality.strip()})"
+
+	doc = frappe.get_doc({
+		"doctype": "CRM Requirement",
+		"title": req_title,
+		"client_name": client_name.strip(),
+		"client_phone": client_phone.strip(),
+		"deal_type": deal_type,
+		"category": category,
+		"bhk": bhk,
+		"budget_max": flt(budget_max),
+		"preferred_locality": preferred_locality.strip(),
+		"target_city": target_city.strip(),
+		"furnishing": furnishing,
+		"timeline": timeline,
+		"notes": notes,
+		"status": "Active",
+	})
+	doc.insert()
+
+	return {"ok": True, "requirement": doc.as_dict()}
+
+
+@frappe.whitelist()
+def save_property_note(property_id: str, note: str) -> dict[str, Any]:
+	check_broker_permission()
+
+	if not frappe.db.exists("CRM Property", property_id):
+		frappe.throw(_("Property not found: {0}").format(property_id), frappe.DoesNotExistError)
+
+	doc = frappe.get_doc("CRM Property", property_id)
+	doc.latest_note = note.strip()
+	doc.save(ignore_permissions=True)
+
+	# Also record in FCRM Note
+	fcrm_note = frappe.get_doc({
+		"doctype": "FCRM Note",
+		"title": f"Note on {doc.property_name}",
+		"content": note.strip(),
+		"reference_doctype": "CRM Property",
+		"reference_docname": property_id,
+	})
+	fcrm_note.insert(ignore_permissions=True)
+
+	return {"ok": True, "property_id": property_id, "note": doc.latest_note}
