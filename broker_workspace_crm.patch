+# Copyright (c) 2026, Frappe Technologies Pvt. Ltd. and contributors
+# For license information, please see license.txt
+
+import re
+from typing import Any, Optional
+
+import frappe
+from frappe import _
+
+
+def flt(v: Any, precision: Optional[int] = None) -> float:
+	try:
+		return float(v or 0)
+	except (ValueError, TypeError):
+		return 0.0
+
+
+def cint(v: Any) -> int:
+	try:
+		return int(v or 0)
+	except (ValueError, TypeError):
+		return 0
+
+
+def parse_bhk(bhk_str: Optional[str]) -> Optional[int]:
+	if not bhk_str:
+		return None
+	m = re.search(r"(\d+)\s*(?:BHK|RK)", str(bhk_str), re.IGNORECASE)
+	if m:
+		return int(m.group(1))
+	return None
+
+
+def normalize_area(area_str: Optional[str]) -> str:
+	if not area_str:
+		return ""
+	return re.sub(r"\s+", " ", str(area_str).strip().lower())
+
+
+def get_furnishing_kind(furn: Optional[str]) -> str:
+	v = (furn or "").strip().lower()
+	if not v or v == "any":
+		return "any"
+	if "semi" in v:
+		return "semi"
+	if "unfurnish" in v or v.startswith("un"):
+		return "unfurnished"
+	if "furnish" in v or "fully" in v:
+		return "furnished"
+	return "any"
+
+
+def score_bhk(want_bhk: Optional[int], have_bhk: Optional[int]) -> tuple[int, Optional[dict[str, Any]]]:
+	if want_bhk is None:
+		return 20, None
+	if have_bhk is None:
+		return 15, {"text": _("BHK not specified"), "ok": False}
+	if have_bhk == want_bhk:
+		return 40, {"text": _("{0} BHK Match").format(want_bhk), "ok": True}
+	if have_bhk == want_bhk + 1:
+		return 20, {"text": _("{0} BHK (One larger)").format(have_bhk), "ok": False}
+	if have_bhk < want_bhk:
+		return 0, {"text": _("{0} BHK (Smaller than wanted)").format(have_bhk), "ok": False}
+	return 0, {"text": _("{0} BHK (Larger than wanted)").format(have_bhk), "ok": False}
+
+
+def score_budget(
+	budget_max: Optional[float], price: Optional[float], deal_type: str = "Rent"
+) -> tuple[int, Optional[dict[str, Any]]]:
+	if not budget_max or flt(budget_max) <= 0:
+		return 18, None
+	if not price or flt(price) <= 0:
+		return 15, {"text": _("Price not listed"), "ok": False}
+
+	b_max = flt(budget_max)
+	p = flt(price)
+
+	if p <= b_max:
+		return 35, {"text": _("Within budget (₹ {0})").format(int(p)), "ok": True}
+
+	over = p - b_max
+	ratio = over / b_max
+
+	if ratio <= 0.10:
+		return 25, {"text": _("~{0}% over budget").format(int(ratio * 100)), "ok": False}
+	if ratio <= 0.25:
+		return 15, {"text": _("~{0}% over budget").format(int(ratio * 100)), "ok": False}
+	return 5, {"text": _("Significantly over budget"), "ok": False}
+
+
+def score_area(want_area: Optional[str], have_area: Optional[str]) -> tuple[int, Optional[dict[str, Any]]]:
+	want = normalize_area(want_area)
+	if not want:
+		return 10, None
+	have = normalize_area(have_area)
+	if not have:
+		return 5, {"text": _("Locality not specified"), "ok": False}
+	if have == want:
+		return 20, {"text": _("In {0}").format(have_area), "ok": True}
+
+	shorter = want if len(want) < len(have) else have
+	longer = have if len(want) < len(have) else want
+
+	if len(shorter) >= 4 and shorter in longer:
+		return 15, {"text": _("Near {0}").format(have_area), "ok": True}
+
+	return 0, {"text": _("{0} (wanted {1})").format(have_area, want_area), "ok": False}
+
+
+def score_furnishing(want_furn: Optional[str], have_furn: Optional[str]) -> tuple[int, Optional[dict[str, Any]]]:
+	w = get_furnishing_kind(want_furn)
+	if w == "any":
+		return 2, None
+	h = get_furnishing_kind(have_furn)
+	if h == "any":
+		return 2, {"text": _("Furnishing unlisted"), "ok": False}
+	if h == w:
+		return 5, {"text": _("{0} ✓").format(have_furn), "ok": True}
+	return 0, {"text": _("{0} (wanted {1})").format(have_furn, want_furn), "ok": False}
+
+
+def tier_for_score(score: int) -> str:
+	if score >= 80:
+		return "strong"
+	if score >= 60:
+		return "good"
+	if score >= 40:
+		return "possible"
+	return "low"
+
+
+@frappe.whitelist()
+def get_property_matches(requirement_id: str, limit: int = 30) -> dict[str, Any]:
+	if frappe.session.user == "Guest":
+		frappe.throw(_("Authentication required"), frappe.AuthenticationError)
+
+	if not frappe.db.exists("CRM Requirement", requirement_id):
+		frappe.throw(_("Requirement not found: {0}").format(requirement_id), frappe.DoesNotExistError)
+
+	req = frappe.get_doc("CRM Requirement", requirement_id)
+	want_bhk = parse_bhk(req.bhk)
+
+	# Broad SQL candidate pool
+	filters = {"status": "Available"}
+	if req.category:
+		filters["category"] = req.category
+
+	candidates = frappe.db.get_list(
+		"CRM Property",
+		filters=filters,
+		fields=[
+			"name",
+			"property_name",
+			"category",
+			"listing_type",
+			"property_type",
+			"bhk",
+			"price",
+			"area",
+			"city",
+			"premise_name",
+			"super_builtup_area",
+			"furnishing",
+			"availability",
+			"owner_name",
+			"owner_phone",
+			"owner_phone_last4",
+			"contact_revealed",
+			"shortlisted",
+		],
+		limit=200,
+	)
+
+	scored_results = []
+	for p in candidates:
+		have_bhk = parse_bhk(p.bhk)
+		bhk_pts, bhk_re = score_bhk(want_bhk, have_bhk)
+		bud_pts, bud_re = score_budget(req.budget_max, p.price, req.deal_type)
+		area_pts, area_re = score_area(req.preferred_locality, p.area)
+		furn_pts, furn_re = score_furnishing(req.furnishing, p.furnishing)
+
+		total_score = bhk_pts + bud_pts + area_pts + furn_pts
+		tier = tier_for_score(total_score)
+
+		if tier == "low":
+			continue
+
+		reasons = [r for r in [bhk_re, bud_re, area_re, furn_re] if r]
+
+		scored_results.append({
+			"property": p,
+			"score": total_score,
+			"tier": tier,
+			"reasons": reasons,
+		})
+
+	scored_results.sort(key=lambda x: x["score"], reverse=True)
+	top_matches = scored_results[: min(100, cint(limit) or 30)]
+
+	# Update matched count on requirement doc
+	if req.matched_count != len(top_matches):
+		req.matched_count = len(top_matches)
+		req.save(ignore_permissions=True)
+
+	return {
+		"requirement": req.as_dict(),
+		"matches": top_matches,
+		"total_matches": len(top_matches),
+	}
+
+
+@frappe.whitelist()
+def get_buyer_matches_for_property(property_id: str, limit: int = 30) -> dict[str, Any]:
+	if frappe.session.user == "Guest":
+		frappe.throw(_("Authentication required"), frappe.AuthenticationError)
+
+	if not frappe.db.exists("CRM Property", property_id):
+		frappe.throw(_("Property not found: {0}").format(property_id), frappe.DoesNotExistError)
+
+	prop = frappe.get_doc("CRM Property", property_id)
+	have_bhk = parse_bhk(prop.bhk)
+
+	# Active requirements in this category
+	requirements = frappe.db.get_list(
+		"CRM Requirement",
+		filters={"status": "Active", "category": prop.category},
+		fields=[
+			"name",
+			"title",
+			"client_name",
+			"client_phone",
+			"deal_type",
+			"category",
+			"bhk",
+			"budget_max",
+			"preferred_locality",
+			"target_city",
+			"furnishing",
+			"timeline",
+		],
+		limit=200,
+	)
+
+	scored_buyers = []
+	for req in requirements:
+		want_bhk = parse_bhk(req.bhk)
+		bhk_pts, bhk_re = score_bhk(want_bhk, have_bhk)
+		bud_pts, bud_re = score_budget(req.budget_max, prop.price, req.deal_type)
+		area_pts, area_re = score_area(req.preferred_locality, prop.area)
+		furn_pts, furn_re = score_furnishing(req.furnishing, prop.furnishing)
+
+		total_score = bhk_pts + bud_pts + area_pts + furn_pts
+		tier = tier_for_score(total_score)
+
+		if tier == "low":
+			continue
+
+		reasons = [r for r in [bhk_re, bud_re, area_re, furn_re] if r]
+
+		scored_buyers.append({
+			"requirement_name": req.name,
+			"title": req.title,
+			"client_name": req.client_name,
+			"client_phone": req.client_phone,
+			"budget_max": req.budget_max,
+			"timeline": req.timeline,
+			"preferred_locality": req.preferred_locality,
+			"score": total_score,
+			"tier": tier,
+			"match_tier": tier.title(),
+			"reasons": reasons,
+			"requirement": req,
+		})
+
+	scored_buyers.sort(key=lambda x: x["score"], reverse=True)
+	top_buyers = scored_buyers[: min(100, cint(limit) or 30)]
+
+	return {
+		"property": prop.as_dict(),
+		"matches": top_buyers,
+		"buyer_matches": top_buyers,
+		"total": len(top_buyers),
+		"total_matches": len(top_buyers),
+	}
