@@ -0,0 +1,29 @@
+# Copyright (c) 2026, Frappe Technologies Pvt. Ltd. and Contributors
+# See license.txt
+
+from crm.tests import CRMTestCase
+
+
+class TestCRMProperty(CRMTestCase):
+	def test_phone_last4_extraction(self):
+		from crm.fcrm.doctype.crm_property.crm_property import CRMProperty
+
+		doc = CRMProperty({"doctype": "CRM Property"})
+		doc.owner_phone = "+91 98765 43210"
+		doc.extract_phone_last4()
+		self.assertEqual(doc.owner_phone_last4, "3210")
+
+	def test_default_property_name(self):
+		from crm.fcrm.doctype.crm_property.crm_property import CRMProperty
+
+		doc = CRMProperty({
+			"doctype": "CRM Property",
+			"bhk": "3 BHK",
+			"property_type": "Apartment",
+			"premise_name": "Shaligram Arcade",
+			"area": "Thaltej",
+			"city": "Ahmedabad",
+		})
+		doc.set_property_name()
+		self.assertIn("3 BHK", doc.property_name)
+		self.assertIn("Shaligram Arcade", doc.property_name)
