+<script setup>
+import { ref, computed, onMounted } from 'vue'
+import { createResource, Button } from 'frappe-ui'
+import { brokerStore } from '@/stores/broker'
+import WhatsAppModal from '@/components/Broker/WhatsAppModal.vue'
+import QuickPropertyModal from '@/components/Broker/QuickPropertyModal.vue'
+import PropertyNoteModal from '@/components/Broker/PropertyNoteModal.vue'
+import WhatsAppFab from '@/components/Broker/WhatsAppFab.vue'
+
+const props = defineProps({
+  category: { type: String, default: 'All' },
+})
+
+const { revealContact, toggleShortlist } = brokerStore()
+
+const activeCategory = ref(props.category || 'All')
+const selectedListingType = ref('All')
+const searchQuery = ref('')
+const selectedBhk = ref('Any')
+const selectedFurnishing = ref('Any')
+const onlyShortlisted = ref(false)
+const currentPage = ref(1)
+const limit = 24
+const viewMode = ref('cards')
+const showWhatsAppModal = ref(false)
+const activeWhatsAppProperty = ref(null)
+const showQuickPropertyModal = ref(false)
+const showNoteModal = ref(false)
+const activeNoteProperty = ref(null)
+
+const categories = [
+  { key: 'All', label: 'All Properties' },
+  { key: 'Residential Rent', label: 'Residential Rent' },
+  { key: 'Residential Sell', label: 'Residential Sell' },
+  { key: 'Commercial Rent', label: 'Commercial Rent' },
+  { key: 'Commercial Sell', label: 'Commercial Sell' },
+]
+
+onMounted(() => {
+  const saved = localStorage.getItem('architech.broker.inventory-view')
+  if (saved === 'table' || saved === 'cards') {
+    viewMode.value = saved
+  } else if (window.innerWidth < 768) {
+    viewMode.value = 'cards'
+  }
+})
+
+function setViewMode(mode) {
+  viewMode.value = mode
+  localStorage.setItem('architech.broker.inventory-view', mode)
+}
+
+const properties = createResource({
+  url: 'crm.api.broker.get_properties',
+  params: computed(() => ({
+    category: activeCategory.value === 'All' ? null : activeCategory.value,
+    listing_type: selectedListingType.value === 'All' ? null : selectedListingType.value,
+    bhk: selectedBhk.value === 'Any' ? null : selectedBhk.value,
+    furnishing: selectedFurnishing.value === 'Any' ? null : selectedFurnishing.value,
+    search: searchQuery.value || null,
+    shortlisted: onlyShortlisted.value ? 1 : null,
+    page: currentPage.value,
+    limit: limit,
+  })),
+  auto: true,
+})
+
+function selectListingType(type) {
+  selectedListingType.value = type
+  currentPage.value = 1
+}
+
+function onPropertySaved() {
+  properties.reload()
+}
+
+function openNoteModal(prop) {
+  activeNoteProperty.value = prop
+  showNoteModal.value = true
+}
+
+const hasActiveFilters = computed(() => {
+  return (
+    activeCategory.value !== 'All' ||
+    selectedBhk.value !== 'Any' ||
+    selectedFurnishing.value !== 'Any' ||
+    searchQuery.value !== '' ||
+    onlyShortlisted.value
+  )
+})
+
+function selectCategory(cat) {
+  activeCategory.value = cat
+  currentPage.value = 1
+}
+
+function applyFilters() {
+  currentPage.value = 1
+  properties.reload()
+}
+
+function clearFilters() {
+  activeCategory.value = 'All'
+  searchQuery.value = ''
+  selectedBhk.value = 'Any'
+  selectedFurnishing.value = 'Any'
+  onlyShortlisted.value = false
+  currentPage.value = 1
+  properties.reload()
+}
+
+function prevPage() {
+  if (currentPage.value > 1) {
+    currentPage.value--
+    properties.reload()
+  }
+}
+
+function nextPage() {
+  if (currentPage.value < (properties.data?.total_pages || 1)) {
+    currentPage.value++
+    properties.reload()
+  }
+}
+
+async function onRevealContact(prop) {
+  const channel = window.innerWidth < 768 ? 'Mobile App' : 'Desktop'
+  const res = await revealContact(prop.name, channel)
+  if (res?.ok) {
+    prop.revealed = true
+    prop.owner_phone = res.owner_phone
+  }
+}
+
+async function onToggleShortlist(prop) {
+  const res = await toggleShortlist(prop.name)
+  if (res) {
+    prop.shortlisted = res.shortlisted
+  }
+}
+
+function dial(phone) {
+  if (!phone) return
+  window.location.href = `tel:${phone.replace(/\s+/g, '')}`
+}
+
+function openWhatsApp(prop) {
+  activeWhatsAppProperty.value = prop
+  showWhatsAppModal.value = true
+}
+
+function formatPrice(val) {
+  if (!val) return '0'
+  const n = Number(val)
+  if (n >= 10000000) return (n / 10000000).toFixed(2) + ' Cr'
+  if (n >= 100000) return (n / 100000).toFixed(2) + ' L'
+  return n.toLocaleString('en-IN')
+}
+
+function createNew() {
+  window.location.href = '/crm/new/CRM%20Property'
+}
+</script>
