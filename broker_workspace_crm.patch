@@ -0,0 +1,66 @@
+# Copyright (c) 2026, Frappe Technologies Pvt. Ltd. and Contributors
+# See license.txt
+
+import sys
+import unittest
+from unittest.mock import MagicMock
+
+if "frappe" not in sys.modules:
+	sys.modules["frappe"] = MagicMock()
+	sys.modules["frappe.utils"] = MagicMock()
+	sys.modules["frappe.core"] = MagicMock()
+	sys.modules["frappe.core.api"] = MagicMock()
+	sys.modules["frappe.core.api.file"] = MagicMock()
+	sys.modules["frappe.rate_limiter"] = MagicMock()
+	sys.modules["frappe.translate"] = MagicMock()
+	sys.modules["crm.utils"] = MagicMock()
+if "bs4" not in sys.modules:
+	sys.modules["bs4"] = MagicMock()
+
+from crm.api.matching import parse_bhk, score_bhk, score_budget, score_area, tier_for_score
+
+
+class TestMatchingEngine(unittest.TestCase):
+	def test_parse_bhk(self):
+		self.assertEqual(parse_bhk("3 BHK"), 3)
+		self.assertEqual(parse_bhk("2BHK Apartment"), 2)
+		self.assertEqual(parse_bhk("1 RK Studio"), 1)
+		self.assertIsNone(parse_bhk(None))
+
+	def test_score_bhk(self):
+		# Exact match
+		pts, reason = score_bhk(3, 3)
+		self.assertEqual(pts, 40)
+		self.assertTrue(reason["ok"])
+
+		# One larger (20 pts tolerance)
+		pts, reason = score_bhk(2, 3)
+		self.assertEqual(pts, 20)
+		self.assertFalse(reason["ok"])
+
+	def test_score_budget(self):
+		# Within budget
+		pts, reason = score_budget(50000, 45000)
+		self.assertEqual(pts, 35)
+		self.assertTrue(reason["ok"])
+
+		# 10% over budget
+		pts, reason = score_budget(50000, 54000)
+		self.assertEqual(pts, 25)
+		self.assertFalse(reason["ok"])
+
+	def test_score_area(self):
+		# Exact match
+		pts, reason = score_area("Bodakdev", "Bodakdev")
+		self.assertEqual(pts, 20)
+		self.assertTrue(reason["ok"])
+
+	def test_tiers(self):
+		self.assertEqual(tier_for_score(90), "strong")
+		self.assertEqual(tier_for_score(70), "good")
+		self.assertEqual(tier_for_score(50), "possible")
+		self.assertEqual(tier_for_score(30), "low")
+
+
+if __name__ == "__main__":
+	unittest.main()
