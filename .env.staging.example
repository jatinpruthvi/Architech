NEXT_PUBLIC_SITE_URL=https://staging.architech.example.com
APP_ENV=staging
NEXT_PUBLIC_APP_ENV=staging
ARCHITECH_CONTACT_ENCRYPTION_KEY=
ARCHITECH_REQUIREMENT_RETENTION_DAYS=30
ARCHITECH_DATA_SOURCE=prisma
ARCHITECH_SEARCH_SOURCE=prisma
ARCHITECH_LEAD_STORAGE=prisma
ARCHITECH_SAVED_SEARCH_STORAGE=prisma
ARCHITECH_MEDIA_STORAGE=r2
ARCHITECH_RERA_SOURCE=demo
ARCHITECH_AUTH_SOURCE=better-auth
ARCHITECH_AI_PROVIDER=disabled
ARCHITECH_GSC_SOURCE=demo
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://staging.architech.example.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.01
LOG_LEVEL=info
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
# Browser-visible twin of R2_PUBLIC_BASE_URL for the next/image loader
# (Cloudflare Image Transformations), used by the next/image loader and the
# render path (lib/media/display-url.ts). Empty → passthrough serving.
# BUILD-TIME: must be present when the app is built (CSP img-src + the
# NEXT_PUBLIC_* inlining are computed at build, not runtime).
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=
# Media kind gate: `images` (default) or `all` (retained video path).
ARCHITECH_MEDIA_KINDS=images
# Per-listing media quota (non-deleted items per draft).
MEDIA_MAX_IMAGES_PER_LISTING=10
# Shared secret for /api/internal/scheduled/* (platform cron). Set
# MEDIA_RETENTION_SWEEP=off when the cron drives the retention sweep.
CRON_SECRET=
# Web-vitals RUM sampling (0..1); 0 disables ingest.
NEXT_PUBLIC_WEB_VITALS_SAMPLE_RATE=0.5
RESEND_API_KEY=
GSC_CREDENTIALS=
GUJARAT_RERA_BASE_URL=
GUJARAT_RERA_API_KEY=
PUBLIC_INDEXING_ENABLED=false
INDEXNOW_KEY=
INDEXNOW_HOST=
NEXT_PUBLIC_SITE_HOST=
LEGAL_GATES_ENFORCE_APPROVAL=true
TRUST_PROXY_HEADERS=true
ALLOW_ORIGINLESS_MUTATIONS=false
