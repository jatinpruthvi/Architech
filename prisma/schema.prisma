generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ListingLifecycle {
  DRAFT
  IN_REVIEW
  ACTIVE
  SOLD
  EXPIRED
  REMOVED
  DUPLICATE
  ARCHIVED
}

enum VerificationStatus {
  DEMO
  SOURCE_REVIEWED
  VERIFIED_PARTNER
  RERA_VERIFIED
  DISPUTED
  STALE
}

enum TranslationStatus {
  ENGLISH_ONLY
  MACHINE_DRAFT
  HUMAN_REVIEW_PENDING
  REVIEWED
}

enum MediaModerationStatus {
  PENDING
  APPROVED
  REJECTED
  TAKEDOWN_REQUESTED
  DELETED
}

enum PropertyType {
  APARTMENT
  ROWHOUSE
  VILLA
  PENTHOUSE
  PLOT
}

enum UserRole {
  BUYER
  BROKER_MEMBER
  BROKER_ADMIN
  MODERATOR
  ADMIN
}

/// Self-declared listing attribution: does this person list as the property
/// owner, or as a broker acting for owners? Captured at sign-up (defaults the
/// listing form) and again per listing (what a buyer is shown).
///
/// NOT a permission. Broker authority comes from `UserRole` plus an active
/// `BrokerUser` membership; this field is an unverified claim and must never
/// be read as authorisation.
enum ListerType {
  OWNER
  BROKER
}

enum LeadMode {
  MASKED
  DIRECT_CONSENTED
}

enum LeadStatus {
  NEW
  ACKNOWLEDGED
  REPLIED
  CLOSED
  DELETED
}


enum ChannelRequestType {
  DEMAND
  SUPPLY
}

enum ChannelRequestStatus {
  DRAFT
  OPEN
  MATCHED
  CLOSED
  CANCELLED
  EXPIRED
}

enum ChannelMatchStatus {
  SUGGESTED
  ACCEPTED
  REJECTED
  DEAL_CREATED
}

enum ChannelDealStatus {
  OPEN
  PENDING_OTHER_CLOSE
  CLOSED
  CANCELLED
}

enum ChannelDealCloseMode {
  SINGLE
  DUAL
}

enum ErpnextSyncStatus {
  PENDING
  IN_FLIGHT
  SUCCESS
  FAILED
  RECONCILED
}

enum CommissionEntryType {
  COMMISSION_INCOME
  COMMISSION_EXPENSE
}

enum LocationSourceStatus {
  STAGING
  ACTIVE
  SUPERSEDED
  WITHDRAWN
}

enum AdministrativeAreaType {
  COUNTRY
  STATE_OR_UT
  DIVISION
  DISTRICT
  SUBDISTRICT
  LOCAL_BODY
  WARD
  VILLAGE
  OTHER
}

enum LocalityKind {
  NEIGHBOURHOOD
  SUBLOCALITY
  SECTOR
  LAYOUT
  VILLAGE
  BUSINESS_DISTRICT
  CORRIDOR
  OTHER
}

enum LocalityAliasType {
  OFFICIAL
  COMMON
  HISTORIC
  TRANSLITERATION
  MISSPELLING
  SEARCH
}

enum AdministrativeAreaRole {
  CONTAINS
  STATE
  DISTRICT
  LOCAL_BODY
  WARD
}

enum PostalLinkType {
  PRIMARY
  SERVED_BY
  INTERSECTS
  MANUAL
}

enum GeocodePrecision {
  EXACT
  BUILDING
  STREET
  POST_OFFICE
  POSTAL_AREA
  LOCALITY
  CITY
  UNKNOWN
}

enum CoordinateVisibility {
  PRIVATE_EXACT
  STREET_APPROXIMATE
  LOCALITY_APPROXIMATE
  HIDDEN
}

enum LocationImportStatus {
  RUNNING
  SUCCEEDED
  SUCCEEDED_WITH_REJECTIONS
  FAILED
  CANCELLED
}

enum LocationImportMode {
  DRY_RUN
  APPLY
}

model City {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  hindiName       String?
  state           String
  country         String   @default("IN")
  latitude        Decimal? @db.Decimal(9, 6)
  longitude       Decimal? @db.Decimal(9, 6)
  // Transitional fixture/search metadata only. Prefixes must never resolve an
  // arbitrary six-digit PIN; production lookup uses exact PostalCode records.
  pincodePrefixes String[] @default([])

  localities          Locality[]
  listings            Listing[]
  organizations       BrokerOrganization[]
  channelRequests     ChannelRequest[]
  savedSearches       SavedSearch[]
  administrativeAreas CityAdministrativeArea[]
  requirements        Requirement[]            @relation("ResolvedRequirementCity")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state, country])
}

model Locality {
  id              String       @id @default(cuid())
  cityId          String
  slug            String
  stableKey       String?      @unique
  name            String
  hindiName       String?
  kind            LocalityKind @default(NEIGHBOURHOOD)
  note            String
  sourceId        String?
  sourceFeatureId String?
  confidence      Decimal?     @db.Decimal(4, 3)
  reviewedAt      DateTime?
  retiredAt       DateTime?

  latitude      Decimal?                                    @db.Decimal(9, 6)
  longitude     Decimal?                                    @db.Decimal(9, 6)
  centroid      Unsupported("geography(Point,4326)")?
  boundary      Unsupported("geometry(MultiPolygon,4326)")?
  bbox          String?
  landmarks     Json?
  demoHomeCount Int                                         @default(0)
  // Transitional read compatibility during the fixture-to-database rollout.
  // New writes use LocalityAlias and LocalityPostalCode rows.
  aliases       String[]                                    @default([])
  pincodes      String[]                                    @default([])

  city                City                         @relation(fields: [cityId], references: [id], onDelete: Cascade)
  source              LocationSource?              @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  listings            Listing[]
  savedSearches       SavedSearch[]
  aliasRecords        LocalityAlias[]
  postalCodes         LocalityPostalCode[]
  postOffices         PostOffice[]
  administrativeAreas LocalityAdministrativeArea[]
  requirements        RequirementLocality[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cityId, slug])
  @@unique([sourceId, sourceFeatureId])
  @@index([name])
  @@index([sourceId])
  @@index([pincodes], type: Gin)
}

model LocationSource {
  id             String               @id @default(cuid())
  key            String               @unique
  name           String
  publisher      String
  sourceUrl      String
  downloadUrl    String?
  licenseName    String?
  licenseUrl     String?
  attribution    String?
  version        String?
  checksumSha256 String?
  publishedAt    DateTime?
  retrievedAt    DateTime
  status         LocationSourceStatus @default(ACTIVE)
  metadata       Json?

  administrativeAreas       AdministrativeArea[]
  cityAreaLinks             CityAdministrativeArea[]
  localityAreaLinks         LocalityAdministrativeArea[]
  localities                Locality[]
  localityAliases           LocalityAlias[]
  postalCodes               PostalCode[]
  postOffices               PostOffice[]
  localityPostalCodes       LocalityPostalCode[]
  administrativePostalCodes AdministrativeAreaPostalCode[]
  importRuns                LocationImportRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdministrativeArea {
  id              String                                      @id @default(cuid())
  type            AdministrativeAreaType
  code            String?
  name            String
  nativeName      String?
  slug            String?
  subtype         String?
  metadata        Json?
  parentId        String?
  sourceId        String?
  sourceFeatureId String?
  latitude        Decimal?                                    @db.Decimal(9, 6)
  longitude       Decimal?                                    @db.Decimal(9, 6)
  centroid        Unsupported("geography(Point,4326)")?
  boundary        Unsupported("geometry(MultiPolygon,4326)")?
  validFrom       DateTime?
  validTo         DateTime?
  isActive        Boolean                                     @default(true)

  parent        AdministrativeArea?            @relation("AdministrativeHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children      AdministrativeArea[]           @relation("AdministrativeHierarchy")
  source        LocationSource?                @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  cityLinks     CityAdministrativeArea[]
  localityLinks LocalityAdministrativeArea[]
  postalCodes   AdministrativeAreaPostalCode[]
  postOffices   PostOffice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, type, code])
  @@unique([sourceId, sourceFeatureId])
  @@index([parentId, type])
  @@index([name, type])
}

model CityAdministrativeArea {
  cityId               String
  administrativeAreaId String
  role                 AdministrativeAreaRole
  isPrimary            Boolean                @default(false)
  sourceId             String?

  city               City               @relation(fields: [cityId], references: [id], onDelete: Cascade)
  administrativeArea AdministrativeArea @relation(fields: [administrativeAreaId], references: [id], onDelete: Cascade)
  source             LocationSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@id([cityId, administrativeAreaId, role])
  @@index([administrativeAreaId, role])
}

model LocalityAdministrativeArea {
  localityId           String
  administrativeAreaId String
  role                 AdministrativeAreaRole
  isPrimary            Boolean                @default(false)
  sourceId             String?

  locality           Locality           @relation(fields: [localityId], references: [id], onDelete: Cascade)
  administrativeArea AdministrativeArea @relation(fields: [administrativeAreaId], references: [id], onDelete: Cascade)
  source             LocationSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@id([localityId, administrativeAreaId, role])
  @@index([administrativeAreaId, role])
}

model LocalityAlias {
  id             String            @id @default(cuid())
  localityId     String
  name           String
  normalizedName String
  languageCode   String            @default("und") @db.VarChar(16)
  scriptCode     String?           @db.VarChar(8)
  type           LocalityAliasType @default(COMMON)
  isPreferred    Boolean           @default(false)
  sourceId       String?

  locality Locality        @relation(fields: [localityId], references: [id], onDelete: Cascade)
  source   LocationSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([localityId, normalizedName, languageCode])
  @@index([normalizedName])
}

model PostalCode {
  code      String    @id @db.VarChar(6)
  sourceId  String?
  isActive  Boolean   @default(true)
  validFrom DateTime?
  validTo   DateTime?

  source              LocationSource?                @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  postOffices         PostOffice[]
  localityLinks       LocalityPostalCode[]
  administrativeAreas AdministrativeAreaPostalCode[]
  listings            Listing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceId])
}

model PostOffice {
  id                   String           @id @default(cuid())
  postalCode           String           @db.VarChar(6)
  name                 String
  officeType           String?
  deliveryStatus       String?
  circleName           String?
  regionName           String?
  divisionName         String?
  districtName         String?
  stateName            String?
  administrativeAreaId String?
  localityId           String?
  sourceId             String
  sourceRecordId       String
  latitude             Decimal?         @db.Decimal(9, 6)
  longitude            Decimal?         @db.Decimal(9, 6)
  coordinatePrecision  GeocodePrecision @default(UNKNOWN)
  digipin              String?          @db.VarChar(10)
  isActive             Boolean          @default(true)
  validFrom            DateTime?
  validTo              DateTime?
  raw                  Json?

  postalCodeRecord   PostalCode          @relation(fields: [postalCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  administrativeArea AdministrativeArea? @relation(fields: [administrativeAreaId], references: [id], onDelete: SetNull)
  locality           Locality?           @relation(fields: [localityId], references: [id], onDelete: SetNull)
  source             LocationSource      @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, sourceRecordId])
  @@index([postalCode, name])
  @@index([districtName, stateName])
  @@index([localityId])
}

model LocalityPostalCode {
  localityId String
  postalCode String         @db.VarChar(6)
  linkType   PostalLinkType @default(SERVED_BY)
  isPrimary  Boolean        @default(false)
  confidence Decimal?       @db.Decimal(4, 3)
  sourceId   String?
  evidence   Json?
  validFrom  DateTime?
  validTo    DateTime?

  locality         Locality        @relation(fields: [localityId], references: [id], onDelete: Cascade)
  postalCodeRecord PostalCode      @relation(fields: [postalCode], references: [code], onDelete: Cascade, onUpdate: Cascade)
  source           LocationSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([localityId, postalCode])
  @@index([postalCode, isPrimary])
}

model AdministrativeAreaPostalCode {
  administrativeAreaId String
  postalCode           String    @db.VarChar(6)
  sourceId             String
  confidence           Decimal?  @db.Decimal(4, 3)
  evidence             Json?
  validFrom            DateTime?
  validTo              DateTime?

  administrativeArea AdministrativeArea @relation(fields: [administrativeAreaId], references: [id], onDelete: Cascade)
  postalCodeRecord   PostalCode         @relation(fields: [postalCode], references: [code], onDelete: Cascade, onUpdate: Cascade)
  source             LocationSource     @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([administrativeAreaId, postalCode, sourceId])
  @@index([postalCode, validTo])
  @@index([sourceId, validTo])
}

model LocationImportRun {
  id                 String               @id @default(cuid())
  sourceId           String
  status             LocationImportStatus
  mode               LocationImportMode
  sourceUri          String
  checksumSha256     String?
  schemaVersion      String
  startedAt          DateTime             @default(now())
  completedAt        DateTime?
  rowsRead           Int                  @default(0)
  rowsAccepted       Int                  @default(0)
  rowsRejected       Int                  @default(0)
  rowsInserted       Int                  @default(0)
  rowsUpdated        Int                  @default(0)
  rejectionReportUri String?
  errorSummary       String?
  metadata           Json?

  source LocationSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([sourceId, startedAt])
  @@index([status, startedAt])
}

model BrokerOrganization {
  id                 String             @id @default(cuid())
  cityId             String?
  slug               String             @unique
  name               String
  legalName          String?
  verificationStatus VerificationStatus @default(SOURCE_REVIEWED)
  reraNumber         String?
  website            String?
  phoneMasked        String?
  email              String?
  /// Broker/business contact revealed to verified counterparty brokers only.
  /// This is never customer contact data.
  businessPhoneE164   String?
  businessPhoneMasked String?

  city     City?        @relation(fields: [cityId], references: [id], onDelete: SetNull)
  users    BrokerUser[]
  listings Listing[]
  leads                Lead[]
  requirements         Requirement[]
  channelRequests      ChannelRequest[]
  channelRequestSources ChannelRequestSource[]
  demandChannelDeals   ChannelDeal[]       @relation("DemandBrokerChannelDeals")
  supplyChannelDeals   ChannelDeal[]       @relation("SupplyBrokerChannelDeals")
  commissionEntries    CommissionEntry[]
  erpnextCloseWrites   ErpnextCloseWrite[]
  inboundProviderEvents InboundProviderEvent[]
  channelNotifications ChannelNotification[]
  audits               AuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationStatus])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  role          UserRole  @default(BUYER)
  /// Self-declared at sign-up; defaults the listing form only. See ListerType.
  listerType    ListerType @default(OWNER)
  phoneMasked   String?
  emailVerified DateTime?
  lastLoginAt   DateTime?

  brokerMemberships BrokerUser[]
  leads             Lead[]
  savedSearches     SavedSearch[]
  audits            AuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model BrokerUser {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           UserRole @default(BROKER_MEMBER)
  active         Boolean  @default(true)

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization BrokerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId, active])
}

model ReraRecord {
  id                 String             @id @default(cuid())
  jurisdictionSlug   String
  registrationNumber String
  state              String
  promoterName       String?
  projectName        String?
  sourceUrl          String?
  retrievedAt        DateTime?
  parserVersion      String?
  confidence         Decimal?           @db.Decimal(5, 4)
  evidence           Json?
  verificationStatus VerificationStatus @default(SOURCE_REVIEWED)
  correctionStatus   String?            @default("none")

  listings Listing[]
  audits   AuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jurisdictionSlug, registrationNumber])
  @@index([jurisdictionSlug, verificationStatus])
  @@index([state, verificationStatus])
}

model Listing {
  id           String  @id @default(cuid())
  stableId     String  @unique
  slug         String  @unique
  cityId       String
  localityId   String
  brokerOrgId  String?
  reraRecordId String?

  title             String
  titleHi           String?
  description       String
  descriptionHi     String?
  note              String?
  lifecycle         ListingLifecycle   @default(DRAFT)
  /// Attribution shown to buyers. Defaults from the lister's account
  /// declaration but is overridable per listing.
  listerType        ListerType         @default(OWNER)
  verification      VerificationStatus @default(DEMO)
  translationStatus TranslationStatus  @default(ENGLISH_ONLY)
  propertyType      PropertyType       @default(APARTMENT)

  priceInr             Int
  priceLabel           String
  pricePerSqft         String?
  bhk                  Int?
  areaSqft             Int?
  // Persisted as an uppercase AvailabilityCode from the application vocabulary;
  // kept nullable String for backward-safe migration of legacy labels.
  availability         String?
  addressLocality      String?
  // Postal code is a delivery area, not locality identity. The relation allows
  // consistency checks while localityId remains the canonical neighbourhood.
  postalCode           String?              @db.VarChar(6)
  digipin              String?              @db.VarChar(10)
  latitude             Decimal?             @db.Decimal(9, 6)
  longitude            Decimal?             @db.Decimal(9, 6)
  publicLatitude       Decimal?             @db.Decimal(9, 6)
  publicLongitude      Decimal?             @db.Decimal(9, 6)
  locationPrecision    GeocodePrecision     @default(LOCALITY)
  coordinateVisibility CoordinateVisibility @default(LOCALITY_APPROXIMATE)
  locationVerifiedAt   DateTime?

  sourceSummary        String?
  meaningfulUpdatedAt  DateTime  @default(now())
  publishedAt          DateTime?
  expiresAt            DateTime?
  canonicalToListingId String?

  /**
   * Full-text search vector created by the raw migration
   * `202608240002_search_indexes` (generated column + GIN/trigram indexes).
   * Declared here so `prisma migrate dev` does not generate a DROP for it;
   * Prisma cannot express the generated-column expression, so the migration
   * owns it and `migrate diff` must keep the two in sync.
   */
  searchVector Unsupported("tsvector")?

  city             City                @relation(fields: [cityId], references: [id], onDelete: Restrict)
  locality         Locality            @relation(fields: [localityId], references: [id], onDelete: Restrict)
  postalCodeRecord PostalCode?         @relation(fields: [postalCode], references: [code], onDelete: SetNull, onUpdate: Cascade)
  brokerOrg        BrokerOrganization? @relation(fields: [brokerOrgId], references: [id], onDelete: SetNull)
  reraRecord       ReraRecord?         @relation(fields: [reraRecordId], references: [id], onDelete: SetNull)
  media                 PropertyMedia[]
  leads                 Lead[]
  audits                AuditEvent[]
  channelRequestSources ChannelRequestSource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId, lifecycle])
  @@index([cityId, localityId, lifecycle, meaningfulUpdatedAt])
  @@index([brokerOrgId, lifecycle, updatedAt])
  @@index([listerType, lifecycle])
  @@index([localityId, lifecycle])
  @@index([verification])
  @@index([priceInr])
  @@index([bhk])
  @@index([meaningfulUpdatedAt])
  @@index([postalCode, lifecycle])
}

model PropertyMedia {
  id               String                @id @default(cuid())
  listingId        String
  kind             String                @default("image")
  url              String
  alt              String?
  width            Int?
  height           Int?
  blurHash         String?
  derivatives      Json?
  licenseEvidence  String?
  exifStripped     Boolean               @default(false)
  moderationStatus MediaModerationStatus @default(PENDING)
  sortOrder        Int                   @default(0)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId, sortOrder])
  @@index([moderationStatus])
}

model Lead {
  id             String     @id @default(cuid())
  listingId      String
  userId         String?
  organizationId String?
  mode           LeadMode   @default(MASKED)
  status         LeadStatus @default(NEW)
  name           String
  phoneMasked    String?
  email          String?
  message        String
  consentText    String
  idempotencyKey String?    @unique
  deletedAt      DateTime?

  listing      Listing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization BrokerOrganization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  audits       AuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId, status])
  @@index([organizationId, status])
  @@index([createdAt])
}

model Requirement {
  id              String    @id @default(cuid())
  cityId          String
  organizationId  String?
  intent          String
  category        String
  subtype         String
  propertyType    String?
  bhkMin          Int?
  bhkMax          Int?
  areaMinSqft     Int?
  areaMaxSqft     Int?
  budgetMinInr    BigInt?
  budgetMaxInr    BigInt?
  role            String
  name            String
  phoneCiphertext Bytes
  phoneLast4      String    @db.VarChar(4)
  consentText     String
  consentedAt     DateTime  @default(now())
  status          String    @default("NEW")
  idempotencyKey  String?   @unique
  retentionUntil  DateTime
  deletedAt       DateTime?

  resolvedCity City                  @relation("ResolvedRequirementCity", fields: [cityId], references: [id], onDelete: Restrict)
  organization BrokerOrganization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  localities   RequirementLocality[]
  channelRequestSources ChannelRequestSource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId, status, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([retentionUntil])
}

model RequirementLocality {
  requirementId String
  localityId    String
  priority      Int    @default(0)

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  locality    Locality    @relation(fields: [localityId], references: [id], onDelete: Restrict)

  @@id([requirementId, localityId])
  @@index([localityId])
}


model ChannelRequest {
  id                  String               @id @default(cuid())
  organizationId      String
  createdById         String
  type                ChannelRequestType
  cityId              String
  localitySlug        String?
  intent              String
  propertyType        String
  bhkMin              Int?
  bhkMax              Int?
  areaMinSqft         Int?
  areaMaxSqft         Int?
  budgetMinInr        BigInt?
  budgetMaxInr        BigInt?
  priceInr            BigInt?
  detailSummary       String
  status              ChannelRequestStatus @default(DRAFT)
  expiresAt           DateTime
  publishedAt         DateTime?
  closedAt            DateTime?
  revision            Int                  @default(1)

  organization  BrokerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  city          City               @relation(fields: [cityId], references: [id], onDelete: Restrict)
  source        ChannelRequestSource?
  demandMatches ChannelMatch[]     @relation("DemandChannelMatches")
  supplyMatches ChannelMatch[]     @relation("SupplyChannelMatches")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([cityId, localitySlug, type, intent, propertyType, status])
  @@index([type, status, cityId, intent, propertyType, priceInr])
  @@index([type, status, cityId, intent, propertyType, budgetMaxInr])
  @@index([type, status, cityId, intent, propertyType, bhkMin, bhkMax])
  @@index([expiresAt])
}

model ChannelRequestSource {
  id                  String @id @default(cuid())
  channelRequestId    String @unique
  organizationId      String
  sourceListingId     String? @unique
  sourceRequirementId String? @unique

  channelRequest ChannelRequest      @relation(fields: [channelRequestId], references: [id], onDelete: Cascade)
  organization   BrokerOrganization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceListing  Listing?            @relation(fields: [sourceListingId], references: [id], onDelete: Restrict)
  sourceRequirement Requirement?      @relation(fields: [sourceRequirementId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([sourceListingId])
  @@index([sourceRequirementId])
}

model ChannelMatch {
  id              String             @id @default(cuid())
  demandRequestId String
  supplyRequestId String
  score           Int
  reasons         Json
  status          ChannelMatchStatus @default(SUGGESTED)
  createdBy       String?

  demandRequest ChannelRequest @relation("DemandChannelMatches", fields: [demandRequestId], references: [id], onDelete: Cascade)
  supplyRequest ChannelRequest @relation("SupplyChannelMatches", fields: [supplyRequestId], references: [id], onDelete: Cascade)
  deal          ChannelDeal?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([demandRequestId, supplyRequestId])
  @@index([status, score])
  @@index([demandRequestId, status])
  @@index([supplyRequestId, status])
}

model ChannelDeal {
  id                   String               @id @default(cuid())
  matchId              String               @unique
  demandOrganizationId String
  supplyOrganizationId String
  demandContactUserId  String?
  supplyContactUserId  String?
  status               ChannelDealStatus    @default(OPEN)
  closeMode            ChannelDealCloseMode @default(DUAL)
  splitAgreement       Json?
  totalCommissionInr   BigInt?
  demandBrokerShareInr BigInt?
  supplyBrokerShareInr BigInt?
  demandBrokerConfirmAt DateTime?
  supplyBrokerConfirmAt DateTime?
  closedAt             DateTime?
  closeVersion         Int                  @default(1)
  erpnextSyncStatus    ErpnextSyncStatus    @default(PENDING)

  match              ChannelMatch       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  demandOrganization BrokerOrganization @relation("DemandBrokerChannelDeals", fields: [demandOrganizationId], references: [id], onDelete: Restrict)
  supplyOrganization BrokerOrganization @relation("SupplyBrokerChannelDeals", fields: [supplyOrganizationId], references: [id], onDelete: Restrict)
  commissionEntries  CommissionEntry[]
  erpnextCloseWrites ErpnextCloseWrite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([demandOrganizationId, status])
  @@index([supplyOrganizationId, status])
}

model CommissionEntry {
  id             String              @id @default(cuid())
  organizationId String
  dealId         String
  entryType      CommissionEntryType
  amountInr      BigInt
  employeeId     String?
  description    String
  entryDate      DateTime
  recordedById   String
  erpnextDocId   String?

  organization BrokerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         ChannelDeal        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([organizationId, dealId, entryType])
  @@index([organizationId, entryDate])
  @@index([dealId])
}

model ErpnextCloseWrite {
  id                String            @id @default(cuid())
  channelDealId     String
  organizationId    String
  idempotencyKey    String            @unique
  payloadHash       String
  status            ErpnextSyncStatus @default(PENDING)
  attemptCount      Int               @default(0)
  lastError         String?
  nextRetryAt       DateTime?
  erpnextDocId      String?
  processedAt       DateTime?

  channelDeal  ChannelDeal        @relation(fields: [channelDealId], references: [id], onDelete: Cascade)
  organization BrokerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextRetryAt])
  @@index([channelDealId])
}

model InboundProviderEvent {
  id             String   @id @default(cuid())
  provider       String
  externalId     String
  organizationId String
  processedAt    DateTime @default(now())

  organization BrokerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([organizationId, processedAt])
}

model ChannelNotification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String?
  eventType      String
  title          String
  body           String
  entityType     String
  entityId       String
  readAt         DateTime?

  organization BrokerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId, readAt, createdAt])
  @@index([entityType, entityId])
}

model SavedSearch {
  id         String  @id @default(cuid())
  userId     String?
  cityId     String?
  localityId String?
  query      String?
  filters    Json
  sort       String?
  notify     Boolean @default(false)
  /**
   * Canonical identity of the search (normalized query + sorted filters +
   * sort), written by the app on every create. The unique index is what makes
   * duplicate detection race-safe: two concurrent identical saves cannot both
   * insert, and a repeat save returns the existing row as a duplicate.
   */
  dedupeKey  String? @unique

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  city     City?     @relation(fields: [cityId], references: [id], onDelete: SetNull)
  locality Locality? @relation(fields: [localityId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, notify])
  @@index([cityId])
  @@index([localityId])
  @@index([sort])
}

/**
 * Authority asset & outreach registry (P1-OFF-001).
 * Durable rows for the governance registry so ARCHITECH_AUTHORITY_STORAGE=
 * prisma survives restarts; the in-memory registry remains the fixture path.
 * `type` is a code from the app vocabulary (guide | local-report | field-note
 * | press | partner); `outcome` likewise (sent | accepted | declined). Kept as
 * String so the enum lives in application code and can grow without a
 * migration.
 */
model AuthorityAsset {
  id                   String  @id
  type                 String
  title                String
  url                  String?
  isNofollow           Boolean @default(true)
  paidForLink          Boolean @default(false)
  disclosure           String  @default("required")
  relationshipRegistry String?

  outreach AuthorityOutreach[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

model AuthorityOutreach {
  id         String  @id
  date       String
  target     String
  assetId    String?
  outcome    String
  reviewedBy String?

  asset AuthorityAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([assetId])
  @@index([date])
}

model AuditEvent {
  id             String  @id @default(cuid())
  actorUserId    String?
  organizationId String?
  listingId      String?
  reraRecordId   String?
  leadId         String?
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  metadata       Json?
  ipHash         String?

  actor        User?               @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  organization BrokerOrganization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  listing      Listing?            @relation(fields: [listingId], references: [id], onDelete: SetNull)
  reraRecord   ReraRecord?         @relation(fields: [reraRecordId], references: [id], onDelete: SetNull)
  lead         Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorUserId])
}
