generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ListingLifecycle {
  DRAFT
  IN_REVIEW
  ACTIVE
  SOLD
  EXPIRED
  REMOVED
  DUPLICATE
  ARCHIVED
}

enum VerificationStatus {
  DEMO
  SOURCE_REVIEWED
  VERIFIED_PARTNER
  RERA_VERIFIED
  DISPUTED
  STALE
}

enum TranslationStatus {
  ENGLISH_ONLY
  MACHINE_DRAFT
  HUMAN_REVIEW_PENDING
  REVIEWED
}

enum MediaModerationStatus {
  PENDING
  APPROVED
  REJECTED
  TAKEDOWN_REQUESTED
  DELETED
}

enum PropertyType {
  APARTMENT
  ROWHOUSE
  VILLA
  PENTHOUSE
  PLOT
}

enum UserRole {
  BUYER
  BROKER_MEMBER
  BROKER_ADMIN
  MODERATOR
  ADMIN
}

/// Self-declared listing attribution: does this person list as the property
/// owner, or as a broker acting for owners? Captured at sign-up (defaults the
/// listing form) and again per listing (what a buyer is shown).
///
/// NOT a permission. Broker authority comes from `UserRole` plus an active
/// `BrokerUser` membership; this field is an unverified claim and must never
/// be read as authorisation.
enum ListerType {
  OWNER
  BROKER
}

enum LeadMode {
  MASKED
  DIRECT_CONSENTED
}

enum LeadStatus {
  NEW
  ACKNOWLEDGED
  REPLIED
  CLOSED
  DELETED
}

enum LocationSourceStatus {
  STAGING
  ACTIVE
  SUPERSEDED
  WITHDRAWN
}

enum AdministrativeAreaType {
  COUNTRY
  STATE_OR_UT
  DIVISION
  DISTRICT
  SUBDISTRICT
  LOCAL_BODY
  WARD
  VILLAGE
  OTHER
}

enum LocalityKind {
  NEIGHBOURHOOD
  SUBLOCALITY
  SECTOR
  LAYOUT
  VILLAGE
  BUSINESS_DISTRICT
  CORRIDOR
  OTHER
}

enum LocalityAliasType {
  OFFICIAL
  COMMON
  HISTORIC
  TRANSLITERATION
  MISSPELLING
  SEARCH
}

enum AdministrativeAreaRole {
  CONTAINS
  STATE
  DISTRICT
  LOCAL_BODY
  WARD
}

enum PostalLinkType {
  PRIMARY
  SERVED_BY
  INTERSECTS
  MANUAL
}

enum GeocodePrecision {
  EXACT
  BUILDING
  STREET
  POST_OFFICE
  POSTAL_AREA
  LOCALITY
  CITY
  UNKNOWN
}

enum CoordinateVisibility {
  PRIVATE_EXACT
  STREET_APPROXIMATE
  LOCALITY_APPROXIMATE
  HIDDEN
}

enum LocationImportStatus {
  RUNNING
  SUCCEEDED
  SUCCEEDED_WITH_REJECTIONS
  FAILED
  CANCELLED
}

enum LocationImportMode {
  DRY_RUN
  APPLY
}

model City {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  hindiName       String?
  state           String
  country         String   @default("IN")
  latitude        Decimal? @db.Decimal(9, 6)
  longitude       Decimal? @db.Decimal(9, 6)
  // Transitional fixture/search metadata only. Prefixes must never resolve an
  // arbitrary six-digit PIN; production lookup uses exact PostalCode records.
  pincodePrefixes String[] @default([])

  localities          Locality[]
  listings            Listing[]
  channelRequests     ChannelRequest[]
  organizations       BrokerOrganization[]
  savedSearches       SavedSearch[]
  administrativeAreas CityAdministrativeArea[]
  requirements        Requirement[]            @relation("ResolvedRequirementCity")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state, country])
}

model Locality {
  id              String       @id @default(cuid())
  cityId          String
  slug            String
  stableKey       String?      @unique
  name            String
  hindiName       String?
  kind            LocalityKind @default(NEIGHBOURHOOD)
  note            String
  sourceId        String?
  sourceFeatureId String?
  confidence      Decimal?     @db.Decimal(4, 3)
  reviewedAt      DateTime?
  retiredAt       DateTime?

  latitude      Decimal?                                    @db.Decimal(9, 6)
  longitude     Decimal?                                    @db.Decimal(9, 6)
  centroid      Unsupported("geography(Point,4326)")?
  boundary      Unsupported("geometry(MultiPolygon,4326)")?
  bbox          String?
  landmarks     Json?
  demoHomeCount Int                                         @default(0)
  // Transitional read compatibility during the fixture-to-database rollout.
  // New writes use LocalityAlias and LocalityPostalCode rows.
  aliases       String[]                                    @default([])
  pincodes      String[]                                    @default([])

  city                City                         @relation(fields: [cityId], references: [id], onDelete: Cascade)
  source              LocationSource?              @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  listings            Listing[]
  channelRequests     ChannelRequest[]
  savedSearches       SavedSearch[]
  aliasRecords        LocalityAlias[]
  postalCodes         LocalityPostalCode[]
  postOffices         PostOffice[]
  administrativeAreas LocalityAdministrativeArea[]
  requirements        RequirementLocality[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cityId, slug])
  @@unique([sourceId, sourceFeatureId])
  @@index([name])
  @@index([sourceId])
  @@index([pincodes], type: Gin)
}

model LocationSource {
  id             String               @id @default(cuid())
  key            String               @unique
  name           String
  publisher      String
  sourceUrl      String
  downloadUrl    String?
  licenseName    String?
  licenseUrl     String?
  attribution    String?
  version        String?
  checksumSha256 String?
  publishedAt    DateTime?
  retrievedAt    DateTime
  status         LocationSourceStatus @default(ACTIVE)
  metadata       Json?

  administrativeAreas       AdministrativeArea[]
  cityAreaLinks             CityAdministrativeArea[]
  localityAreaLinks         LocalityAdministrativeArea[]
  localities                Locality[]
  localityAliases           LocalityAlias[]
  postalCodes               PostalCode[]
  postOffices               PostOffice[]
  localityPostalCodes       LocalityPostalCode[]
  administrativePostalCodes AdministrativeAreaPostalCode[]
  importRuns                LocationImportRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdministrativeArea {
  id              String                                      @id @default(cuid())
  type            AdministrativeAreaType
  code            String?
  name            String
  nativeName      String?
  slug            String?
  subtype         String?
  metadata        Json?
  parentId        String?
  sourceId        String?
  sourceFeatureId String?
  latitude        Decimal?                                    @db.Decimal(9, 6)
  longitude       Decimal?                                    @db.Decimal(9, 6)
  centroid        Unsupported("geography(Point,4326)")?
  boundary        Unsupported("geometry(MultiPolygon,4326)")?
  validFrom       DateTime?
  validTo         DateTime?
  isActive        Boolean                                     @default(true)

  parent        AdministrativeArea?            @relation("AdministrativeHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children      AdministrativeArea[]           @relation("AdministrativeHierarchy")
  source        LocationSource?                @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  cityLinks     CityAdministrativeArea[]
  localityLinks LocalityAdministrativeArea[]
  postalCodes   AdministrativeAreaPostalCode[]
  postOffices   PostOffice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, type, code])
  @@unique([sourceId, sourceFeatureId])
  @@index([parentId, type])
  @@index([name, type])
}

model CityAdministrativeArea {
  cityId               String
  administrativeAreaId String
  role                 AdministrativeAreaRole
  isPrimary            Boolean                @default(false)
  sourceId             String?

  city               City               @relation(fields: [cityId], references: [id], onDelete: Cascade)
  administrativeArea AdministrativeArea @relation(fields: [administrativeAreaId], references: [id], onDelete: Cascade)
  source             LocationSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@id([cityId, administrativeAreaId, role])
  @@index([administrativeAreaId, role])
}

model LocalityAdministrativeArea {
  localityId           String
  administrativeAreaId String
  role                 AdministrativeAreaRole
  isPrimary            Boolean                @default(false)
  sourceId             String?

  locality           Locality           @relation(fields: [localityId], references: [id], onDelete: Cascade)
  administrativeArea AdministrativeArea @relation(fields: [administrativeAreaId], references: [id], onDelete: Cascade)
  source             LocationSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@id([localityId, administrativeAreaId, role])
  @@index([administrativeAreaId, role])
}

model LocalityAlias {
  id             String            @id @default(cuid())
  localityId     String
  name           String
  normalizedName String
  languageCode   String            @default("und") @db.VarChar(16)
  scriptCode     String?           @db.VarChar(8)
  type           LocalityAliasType @default(COMMON)
  isPreferred    Boolean           @default(false)
  sourceId       String?

  locality Locality        @relation(fields: [localityId], references: [id], onDelete: Cascade)
  source   LocationSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([localityId, normalizedName, languageCode])
  @@index([normalizedName])
}

model PostalCode {
  code      String    @id @db.VarChar(6)
  sourceId  String?
  isActive  Boolean   @default(true)
  validFrom DateTime?
  validTo   DateTime?

  source              LocationSource?                @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  postOffices         PostOffice[]
  localityLinks       LocalityPostalCode[]
  administrativeAreas AdministrativeAreaPostalCode[]
  listings            Listing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceId])
}

model PostOffice {
  id                   String           @id @default(cuid())
  postalCode           String           @db.VarChar(6)
  name                 String
  officeType           String?
  deliveryStatus       String?
  circleName           String?
  regionName           String?
  divisionName         String?
  districtName         String?
  stateName            String?
  administrativeAreaId String?
  localityId           String?
  sourceId             String
  sourceRecordId       String
  latitude             Decimal?         @db.Decimal(9, 6)
  longitude            Decimal?         @db.Decimal(9, 6)
  coordinatePrecision  GeocodePrecision @default(UNKNOWN)
  digipin              String?          @db.VarChar(10)
  isActive             Boolean          @default(true)
  validFrom            DateTime?
  validTo              DateTime?
  raw                  Json?

  postalCodeRecord   PostalCode          @relation(fields: [postalCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  administrativeArea AdministrativeArea? @relation(fields: [administrativeAreaId], references: [id], onDelete: SetNull)
  locality           Locality?           @relation(fields: [localityId], references: [id], onDelete: SetNull)
  source             LocationSource      @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, sourceRecordId])
  @@index([postalCode, name])
  @@index([districtName, stateName])
  @@index([localityId])
}

model LocalityPostalCode {
  localityId String
  postalCode String         @db.VarChar(6)
  linkType   PostalLinkType @default(SERVED_BY)
  isPrimary  Boolean        @default(false)
  confidence Decimal?       @db.Decimal(4, 3)
  sourceId   String?
  evidence   Json?
  validFrom  DateTime?
  validTo    DateTime?

  locality         Locality        @relation(fields: [localityId], references: [id], onDelete: Cascade)
  postalCodeRecord PostalCode      @relation(fields: [postalCode], references: [code], onDelete: Cascade, onUpdate: Cascade)
  source           LocationSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([localityId, postalCode])
  @@index([postalCode, isPrimary])
}

model AdministrativeAreaPostalCode {
  administrativeAreaId String
  postalCode           String    @db.VarChar(6)
  sourceId             String
  confidence           Decimal?  @db.Decimal(4, 3)
  evidence             Json?
  validFrom            DateTime?
  validTo              DateTime?

  administrativeArea AdministrativeArea @relation(fields: [administrativeAreaId], references: [id], onDelete: Cascade)
  postalCodeRecord   PostalCode         @relation(fields: [postalCode], references: [code], onDelete: Cascade, onUpdate: Cascade)
  source             LocationSource     @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([administrativeAreaId, postalCode, sourceId])
  @@index([postalCode, validTo])
  @@index([sourceId, validTo])
}

model LocationImportRun {
  id                 String               @id @default(cuid())
  sourceId           String
  status             LocationImportStatus
  mode               LocationImportMode
  sourceUri          String
  checksumSha256     String?
  schemaVersion      String
  startedAt          DateTime             @default(now())
  completedAt        DateTime?
  rowsRead           Int                  @default(0)
  rowsAccepted       Int                  @default(0)
  rowsRejected       Int                  @default(0)
  rowsInserted       Int                  @default(0)
  rowsUpdated        Int                  @default(0)
  rejectionReportUri String?
  errorSummary       String?
  metadata           Json?

  source LocationSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([sourceId, startedAt])
  @@index([status, startedAt])
}

model BrokerOrganization {
  id                 String             @id @default(cuid())
  cityId             String?
  slug               String             @unique
  name               String
  legalName          String?
  verificationStatus VerificationStatus @default(SOURCE_REVIEWED)
  reraNumber         String?
  website            String?
  phoneMasked        String?
  email              String?

  /// Agency switchboard number in E.164 (+919876543210), NOT an end customer's.
  ///
  /// This is the number revealed to a counterparty brokerage on an accepted
  /// broker-channel match so the two firms can call or WhatsApp each other
  /// directly. E.164 is mandatory rather than stylistic: ERPNext resolves
  /// contacts by exact string match on the phone column
  /// (erpnext/crm/frappe_crm_api.py:115), so an unnormalised value duplicates
  /// the same firm across Customer/Contact records. Always write through
  /// lib/interop/phone.ts.
  ///
  /// Still personal data. Revealing it requires an accepted match and is
  /// audited; it is not public directory information.
  businessPhoneE164  String?            @db.VarChar(20)
  /// Set when a human has confirmed the number reaches the agency. Reveal is
  /// gated on this, so an unverified number cannot strand a counterparty.
  businessPhoneVerifiedAt DateTime?

  /// Foreign key into this brokerage's own Frappe/ERPNext site. Opaque to us.
  ///
  /// Frappe primary keys are varchar(140) (frappe/database/database.py:91), so
  /// the width is theirs, not ours. We only ever store a value a Frappe site
  /// returned to us and echo it back on later calls; we never construct one and
  /// never reuse it across sites, because two businesses' sites are separate
  /// databases whose keys collide freely.
  erpnextCustomerId  String?            @db.VarChar(140)
  frappeCrmOrgId     String?            @db.VarChar(140)

  /// GSTIN, 15 chars, format enforced by India Compliance
  /// (gst_india/constants: GSTIN_FORMAT). Its first two digits are the GST
  /// state code, which India Compliance cross-checks against the address state
  /// and rejects on mismatch (gst_india/overrides/address.py:97).
  ///
  /// NOT the LGD state code we store elsewhere. The two vocabularies disagree
  /// for twelve states -- LGD 37 is Ladakh while GST 37 is Andhra Pradesh --
  /// so always translate through lib/interop/india-state-mapping.ts.
  gstin              String?            @db.VarChar(15)
  /// LGD state name, the key into that mapping. Kept alongside the city
  /// relation because a brokerage can invoice from a state it does not have a
  /// city record for.
  registeredStateLgd String?

  city     City?        @relation(fields: [cityId], references: [id], onDelete: SetNull)
  users    BrokerUser[]
  listings Listing[]
  leads    Lead[]
  audits   AuditEvent[]
  outbox   InteropOutbox[]
  channelRequests      ChannelRequest[]
  channelNotifications ChannelNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationStatus])
  /// Reverse lookup when a Frappe webhook arrives carrying only its own key.
  @@index([erpnextCustomerId])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  role          UserRole  @default(BUYER)
  /// Self-declared at sign-up; defaults the listing form only. See ListerType.
  listerType    ListerType @default(OWNER)
  phoneMasked   String?
  emailVerified DateTime?
  lastLoginAt   DateTime?

  brokerMemberships BrokerUser[]
  leads             Lead[]
  savedSearches     SavedSearch[]
  audits            AuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model BrokerUser {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           UserRole @default(BROKER_MEMBER)
  active         Boolean  @default(true)

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization BrokerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId, active])
}

model ReraRecord {
  id                 String             @id @default(cuid())
  jurisdictionSlug   String
  registrationNumber String
  state              String
  promoterName       String?
  projectName        String?
  sourceUrl          String?
  retrievedAt        DateTime?
  parserVersion      String?
  confidence         Decimal?           @db.Decimal(5, 4)
  evidence           Json?
  verificationStatus VerificationStatus @default(SOURCE_REVIEWED)
  correctionStatus   String?            @default("none")

  listings Listing[]
  audits   AuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jurisdictionSlug, registrationNumber])
  @@index([jurisdictionSlug, verificationStatus])
  @@index([state, verificationStatus])
}

model Listing {
  id           String  @id @default(cuid())
  stableId     String  @unique
  slug         String  @unique
  cityId       String
  localityId   String
  brokerOrgId  String?
  reraRecordId String?

  title             String
  titleHi           String?
  description       String
  descriptionHi     String?
  note              String?
  lifecycle         ListingLifecycle   @default(DRAFT)
  /// Attribution shown to buyers. Defaults from the lister's account
  /// declaration but is overridable per listing.
  listerType        ListerType         @default(OWNER)
  verification      VerificationStatus @default(DEMO)
  translationStatus TranslationStatus  @default(ENGLISH_ONLY)
  propertyType      PropertyType       @default(APARTMENT)

  // BigInt, not Int: a 32-bit column caps at ₹2,147,483,647 (~₹214 crore),
  // which is reachable for commercial property and land. Read through
  // lib/money.ts at the boundary; the domain layer works in `number`.
  priceInr             BigInt
  priceLabel           String
  pricePerSqft         String?
  bhk                  Int?
  areaSqft             Int?
  // Persisted as an uppercase AvailabilityCode from the application vocabulary;
  // kept nullable String for backward-safe migration of legacy labels.
  availability         String?
  addressLocality      String?
  // Postal code is a delivery area, not locality identity. The relation allows
  // consistency checks while localityId remains the canonical neighbourhood.
  postalCode           String?              @db.VarChar(6)
  digipin              String?              @db.VarChar(10)
  latitude             Decimal?             @db.Decimal(9, 6)
  longitude            Decimal?             @db.Decimal(9, 6)
  publicLatitude       Decimal?             @db.Decimal(9, 6)
  publicLongitude      Decimal?             @db.Decimal(9, 6)
  locationPrecision    GeocodePrecision     @default(LOCALITY)
  coordinateVisibility CoordinateVisibility @default(LOCALITY_APPROXIMATE)
  locationVerifiedAt   DateTime?

  sourceSummary        String?
  meaningfulUpdatedAt  DateTime  @default(now())
  publishedAt          DateTime?
  expiresAt            DateTime?
  canonicalToListingId String?

  /**
   * Full-text search vector created by the raw migration
   * `202608240002_search_indexes` (generated column + GIN/trigram indexes).
   * Declared here so `prisma migrate dev` does not generate a DROP for it;
   * Prisma cannot express the generated-column expression, so the migration
   * owns it and `migrate diff` must keep the two in sync.
   */
  searchVector Unsupported("tsvector")?

  city             City                @relation(fields: [cityId], references: [id], onDelete: Restrict)
  locality         Locality            @relation(fields: [localityId], references: [id], onDelete: Restrict)
  postalCodeRecord PostalCode?         @relation(fields: [postalCode], references: [code], onDelete: SetNull, onUpdate: Cascade)
  brokerOrg        BrokerOrganization? @relation(fields: [brokerOrgId], references: [id], onDelete: SetNull)
  reraRecord       ReraRecord?         @relation(fields: [reraRecordId], references: [id], onDelete: SetNull)
  media            PropertyMedia[]
  leads            Lead[]
  audits           AuditEvent[]
  channelRequests  ChannelRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId, lifecycle])
  @@index([cityId, localityId, lifecycle, meaningfulUpdatedAt])
  @@index([brokerOrgId, lifecycle, updatedAt])
  @@index([listerType, lifecycle])
  @@index([localityId, lifecycle])
  @@index([verification])
  @@index([priceInr])
  @@index([bhk])
  @@index([meaningfulUpdatedAt])
  @@index([postalCode, lifecycle])
}

model PropertyMedia {
  id               String                @id @default(cuid())
  listingId        String
  kind             String                @default("image")
  url              String
  alt              String?
  width            Int?
  height           Int?
  blurHash         String?
  derivatives      Json?
  licenseEvidence  String?
  exifStripped     Boolean               @default(false)
  moderationStatus MediaModerationStatus @default(PENDING)
  sortOrder        Int                   @default(0)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId, sortOrder])
  @@index([moderationStatus])
}

model Lead {
  id             String     @id @default(cuid())
  listingId      String
  userId         String?
  organizationId String?
  mode           LeadMode   @default(MASKED)
  status         LeadStatus @default(NEW)
  name           String
  phoneMasked    String?
  email          String?
  message        String
  consentText    String
  idempotencyKey String?    @unique
  deletedAt      DateTime?

  /// Key of the `CRM Lead` this became on the brokerage's Frappe site.
  ///
  /// Mirrors upstream's own pattern for external-system identifiers: Frappe CRM
  /// stores `facebook_lead_id` as a unique `Data` column and lets the database
  /// reject re-imports. Same idea inverted -- we hold their key so a retried
  /// projection updates rather than duplicates.
  ///
  /// varchar(140) because that is Frappe's universal Data/Link width. Not
  /// globally unique: two brokerages run separate sites whose keys collide, so
  /// uniqueness is only meaningful per organization.
  frappeCrmLeadId String?   @db.VarChar(140)
  /// Set once the projection is acknowledged, so a sweeper can find leads that
  /// were created but never reached the CRM.
  frappeSyncedAt  DateTime?

  listing      Listing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization BrokerOrganization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  audits       AuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId, status])
  @@index([organizationId, status])
  @@index([createdAt])
  /// A Frappe key is only unique within one brokerage's site.
  @@unique([organizationId, frappeCrmLeadId])
}

model Requirement {
  id              String    @id @default(cuid())
  cityId          String
  intent          String
  category        String
  subtype         String
  role            String
  name            String
  phoneCiphertext Bytes
  phoneLast4      String    @db.VarChar(4)
  consentText     String
  consentedAt     DateTime  @default(now())
  status          String    @default("NEW")
  idempotencyKey  String?   @unique
  retentionUntil  DateTime
  deletedAt       DateTime?

  resolvedCity City                  @relation("ResolvedRequirementCity", fields: [cityId], references: [id], onDelete: Restrict)
  localities   RequirementLocality[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId, status, createdAt])
  @@index([retentionUntil])
}

model RequirementLocality {
  requirementId String
  localityId    String
  priority      Int    @default(0)

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  locality    Locality    @relation(fields: [localityId], references: [id], onDelete: Restrict)

  @@id([requirementId, localityId])
  @@index([localityId])
}

model SavedSearch {
  id         String  @id @default(cuid())
  userId     String?
  cityId     String?
  localityId String?
  query      String?
  filters    Json
  sort       String?
  notify     Boolean @default(false)
  /**
   * Canonical identity of the search (normalized query + sorted filters +
   * sort), written by the app on every create. The unique index is what makes
   * duplicate detection race-safe: two concurrent identical saves cannot both
   * insert, and a repeat save returns the existing row as a duplicate.
   */
  dedupeKey  String? @unique

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  city     City?     @relation(fields: [cityId], references: [id], onDelete: SetNull)
  locality Locality? @relation(fields: [localityId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, notify])
  @@index([cityId])
  @@index([localityId])
  @@index([sort])
}

/**
 * Authority asset & outreach registry (P1-OFF-001).
 * Durable rows for the governance registry so ARCHITECH_AUTHORITY_STORAGE=
 * prisma survives restarts; the in-memory registry remains the fixture path.
 * `type` is a code from the app vocabulary (guide | local-report | field-note
 * | press | partner); `outcome` likewise (sent | accepted | declined). Kept as
 * String so the enum lives in application code and can grow without a
 * migration.
 */
model AuthorityAsset {
  id                   String  @id
  type                 String
  title                String
  url                  String?
  isNofollow           Boolean @default(true)
  paidForLink          Boolean @default(false)
  disclosure           String  @default("required")
  relationshipRegistry String?

  outreach AuthorityOutreach[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

model AuthorityOutreach {
  id         String  @id
  date       String
  target     String
  assetId    String?
  outcome    String
  reviewedBy String?

  asset AuthorityAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([assetId])
  @@index([date])
}

model AuditEvent {
  id             String  @id @default(cuid())
  actorUserId    String?
  organizationId String?
  listingId      String?
  reraRecordId   String?
  leadId         String?
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  metadata       Json?
  ipHash         String?

  actor        User?               @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  organization BrokerOrganization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  listing      Listing?            @relation(fields: [listingId], references: [id], onDelete: SetNull)
  reraRecord   ReraRecord?         @relation(fields: [reraRecordId], references: [id], onDelete: SetNull)
  lead         Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorUserId])
}

/// Delivery state for one outbound projection to an external Frappe/ERPNext
/// site. Shared by every integration rather than one enum per target, because
/// the retry/reconcile machinery is identical for all of them.
enum InteropSyncStatus {
  PENDING
  IN_FLIGHT
  SUCCESS
  FAILED
  /// The document existed and was then CANCELLED upstream (Frappe docstatus 2).
  ///
  /// This state exists because of a real failure mode. ERPNext's Journal Entry
  /// and Sales Invoice are submittable ("is_submittable": 1), and a cancelled
  /// document still exists and still holds its unique field values. A naive
  /// "key exists -> duplicate, report success" check therefore reports SUCCESS
  /// for a commission that has been reversed out of the books. The write must
  /// be re-driven or escalated, never silently treated as delivered.
  CANCELLED_UPSTREAM
  /// Retries exhausted; a human has reconciled the discrepancy.
  RECONCILED
}

/// Durable outbox for anything Architech pushes into a business's Frappe or
/// ERPNext site.
///
/// WHY AN OUTBOX AND NOT A DIRECT CALL: the two systems are separate databases
/// reached over HTTP. A commission must not be lost because a site was
/// restarting, and must not be posted twice because we retried. Rows are
/// written in the same transaction as the business fact, then drained by a
/// worker. This is the "durable idempotent processor" the v8 decision requires
/// in place of cross-database writes.
model InteropOutbox {
  id             String            @id @default(cuid())
  /// Owning tenant. Every row is scoped; there is no cross-business fallback.
  organizationId String

  /// What is being projected, e.g. "lead.created", "channel.deal.closed".
  eventType      String            @db.VarChar(64)
  /// Our own entity, so a failed row can be traced back without opening JSON.
  entityType     String            @db.VarChar(64)
  entityId       String

  /// Bounded to 128 chars, comfortably inside Frappe's varchar(140) Data limit.
  /// A longer key would truncate on the receiving side and two different deals
  /// could collide onto one document, so the constraint is enforced here where
  /// it fails loudly rather than there where it fails silently.
  idempotencyKey String            @unique @db.VarChar(128)
  /// Hash of the payload actually sent. Lets reconciliation distinguish "this
  /// was already delivered" from "the facts changed and need a new version".
  payloadHash    String            @db.VarChar(64)
  payload        Json

  status         InteropSyncStatus @default(PENDING)
  attemptCount   Int               @default(0)
  lastError      String?
  nextRetryAt    DateTime?

  /// Whatever key the remote site returned. Opaque; never parsed.
  remoteDocId    String?           @db.VarChar(140)
  /// Frappe docstatus of the remote document: 0 draft, 1 submitted,
  /// 2 cancelled. Stored so reconciliation can detect an upstream cancellation
  /// without a second round trip.
  remoteDocstatus Int?
  processedAt    DateTime?

  organization BrokerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The worker's claim query: due work, oldest first.
  @@index([status, nextRetryAt])
  @@index([organizationId, eventType, status])
  @@index([entityType, entityId])
}

/// Inbound de-duplication for webhooks and callbacks from external systems.
///
/// Providers retry, and Frappe hooks can fire more than once. A processed
/// (provider, externalId) pair is recorded here so replay is a no-op instead of
/// a second state transition.
model InteropInboundEvent {
  id             String   @id @default(cuid())
  /// e.g. "frappe-crm", "erpnext", "evolution".
  provider       String   @db.VarChar(32)
  /// The remote system's own event/document identifier.
  externalId     String   @db.VarChar(140)
  organizationId String?

  eventType   String?  @db.VarChar(64)
  processedAt DateTime @default(now())

  @@unique([provider, externalId])
  @@index([organizationId, processedAt])
}

// ---------------------------------------------------------------------------
// Broker channel
//
// A privacy-preserving B2B layer where verified brokerages exchange demand and
// supply. One agency holds a buyer looking in Thaltej; another holds the
// matching flat. The channel lets them find each other, then talk directly.
//
// ANCHORED ON LISTINGS, BY DESIGN.
//
// A SUPPLY request must reference a real, ACTIVE Listing rather than restating
// price/BHK/area as loose fields. That decision does a lot of work:
//
//   - Matching scores against verified inventory instead of self-reported
//     numbers, so a score means something.
//   - The counterparty sees the actual listing: photos, RERA, locality, the
//     full dossier. No parallel description to keep in sync, and no way for the
//     two to drift apart.
//   - Publishing to the channel requires first publishing to the site, so the
//     public catalogue grows as a side effect of brokers using the channel.
//   - Contact flows through the listing's own broker organization, which is
//     already verified and already has a business number.
//
// DEMAND is deliberately NOT listing-anchored: a buyer requirement has no
// listing yet. It carries structured criteria instead.
//
// PRIVACY BOUNDARY: channel records carry no end-customer identity. A demand
// request describes what a buyer wants, never who they are. The only contact
// revealed is the counterparty BROKERAGE's business number.
// ---------------------------------------------------------------------------

enum ChannelRequestType {
  /// A buyer requirement. Structured criteria; no listing exists yet.
  DEMAND
  /// Inventory offered. Must reference an ACTIVE Listing.
  SUPPLY
}

enum ChannelRequestStatus {
  DRAFT
  OPEN
  MATCHED
  CLOSED
  CANCELLED
  EXPIRED
}

enum ChannelMatchStatus {
  /// Created by the matcher; neither side has acted.
  SUGGESTED
  /// One side accepted, waiting on the other.
  ACCEPTED
  REJECTED
  /// Both accepted; contact details are now mutually visible.
  CONNECTED
}

enum ChannelIntent {
  BUY
  RENT
}

/// A published demand or supply request.
model ChannelRequest {
  id             String             @id @default(cuid())
  /// Owning brokerage. RLS tenant key.
  organizationId String
  createdByUserId String?
  type           ChannelRequestType
  intent         ChannelIntent
  status         ChannelRequestStatus @default(DRAFT)

  /// SUPPLY: the listing being offered. Required for SUPPLY, null for DEMAND.
  /// Enforced by a CHECK constraint in the migration, not just convention --
  /// a SUPPLY row without a listing would silently score against nothing.
  listingId String?

  /// Search scope. For SUPPLY these are denormalised from the listing at
  /// publish time so the matcher can filter without a join, and refreshed on
  /// re-publish. For DEMAND they are the buyer's stated criteria.
  cityId       String
  localityId   String?
  propertyType PropertyType

  /// DEMAND only: budget range and desired shape. Null on SUPPLY, where the
  /// listing is authoritative for price and size.
  budgetMinInr BigInt?
  budgetMaxInr BigInt?
  bhkMin       Int?
  bhkMax       Int?
  areaMinSqft  Int?
  areaMaxSqft  Int?

  /// Structured, broker-facing note. Sanitised on write: no phone, email or
  /// customer name may appear here. Never describes WHO the buyer is.
  brokerNote String? @db.VarChar(500)

  /// Requests expire so the channel does not fill with stale demand.
  expiresAt   DateTime
  publishedAt DateTime?
  closedAt    DateTime?

  organization  BrokerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listing       Listing?           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  city          City               @relation(fields: [cityId], references: [id], onDelete: Restrict)
  locality      Locality?          @relation(fields: [localityId], references: [id], onDelete: SetNull)
  demandMatches ChannelMatch[]     @relation("DemandRequest")
  supplyMatches ChannelMatch[]     @relation("SupplyRequest")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  /// The matcher's candidate query.
  @@index([status, type, intent, cityId, propertyType])
  @@index([localityId, status])
  @@index([expiresAt])
  @@index([listingId])
}

/// A scored pairing between one demand and one supply request.
model ChannelMatch {
  id              String             @id @default(cuid())
  demandRequestId String
  supplyRequestId String

  /// Denormalised owners. Both sides query "my matches" constantly, and
  /// reaching them through two request joins is the hot path.
  demandOrganizationId String
  supplyOrganizationId String

  /// 0-100, deterministic.
  score   Int
  /// Per-factor breakdown, so a broker sees WHY rather than a bare number.
  reasons Json

  status ChannelMatchStatus @default(SUGGESTED)

  /// Independent accept flags. Contact is revealed only when both are set,
  /// which is what makes the reveal mutual rather than unilateral.
  demandAcceptedAt DateTime?
  supplyAcceptedAt DateTime?
  rejectedAt       DateTime?
  rejectedByOrgId  String?
  connectedAt      DateTime?

  demandRequest ChannelRequest @relation("DemandRequest", fields: [demandRequestId], references: [id], onDelete: Cascade)
  supplyRequest ChannelRequest @relation("SupplyRequest", fields: [supplyRequestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One pairing per request couple: re-running the matcher must not duplicate.
  @@unique([demandRequestId, supplyRequestId])
  @@index([demandOrganizationId, status, score])
  @@index([supplyOrganizationId, status, score])
  @@index([status, score])
}

/// In-app notification. The v8 decision fixes the channel notification surface
/// as Architech only -- no WhatsApp, email or SMS path for channel events.
model ChannelNotification {
  id             String  @id @default(cuid())
  organizationId String
  matchId        String?
  kind           String  @db.VarChar(48)
  title          String  @db.VarChar(160)
  body           String  @db.VarChar(400)
  readAt         DateTime?

  organization BrokerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId, readAt, createdAt])
}
