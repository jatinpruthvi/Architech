{
  "description": "Phase 1 performance budgets for the Architech public prototype. Budgets are intentionally conservative enough to catch regressions before backend/map/media work lands.",
  "routes": {
    "default": {
      "maxFirstLoadJsBytes": 760000,
      "maxFirstLoadJsGzipBytes": 230000
    }
  },
  "html": {
    "maxHtmlBytes": 120000,
    "routes": [
      { "route": "/", "file": ".next/server/app/index.html" },
      { "route": "/buy/ahmedabad/", "file": ".next/server/app/buy/ahmedabad.html" },
      { "route": "/buy/ahmedabad/paldi/", "file": ".next/server/app/buy/ahmedabad/paldi.html" },
      { "route": "/listing/garden-courtyard/", "file": ".next/server/app/listing/garden-courtyard.html" },
      { "route": "/search/", "file": ".next/server/app/search.html" },
      { "route": "/saved/", "file": ".next/server/app/saved.html" }
    ]
  },
  "staticAssets": {
    "maxTotalStaticJsBytes": 1200000,
    "maxLargestChunkBytes": 260000,
    "maxLargestChunkGzipBytes": 80000,
    "maxMobileWebpBytes": 225000,
    "maxFullWebpBytes": 300000,
    "maxJpegBytes": 400000
  },
  "coreWebVitalsTargets": {
    "lcpMs": 2500,
    "inpMs": 200,
    "cls": 0.1,
    "ttfbMs": 800
  }
}
