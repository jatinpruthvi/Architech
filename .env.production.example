NEXT_PUBLIC_SITE_URL=https://architech.example.com
APP_ENV=production
NEXT_PUBLIC_APP_ENV=production
ARCHITECH_CONTACT_ENCRYPTION_KEY=
ARCHITECH_REQUIREMENT_RETENTION_DAYS=180
ARCHITECH_DATA_SOURCE=prisma
ARCHITECH_SEARCH_SOURCE=prisma
ARCHITECH_LEAD_STORAGE=prisma
ARCHITECH_SAVED_SEARCH_STORAGE=prisma
ARCHITECH_MEDIA_STORAGE=r2
ARCHITECH_RERA_SOURCE=demo
ARCHITECH_AUTH_SOURCE=better-auth
ARCHITECH_AI_PROVIDER=disabled
ARCHITECH_GSC_SOURCE=demo
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://architech.example.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.01
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.001
LOG_LEVEL=info
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
# Browser-visible twin of R2_PUBLIC_BASE_URL. It is inlined into the client
# bundle at BUILD time and used by (a) the next/image custom loader and
# (b) the render path (lib/media/display-url.ts) to rewrite R2 URLs to
# Cloudflare Image Transformations URLs at the edge. Leave empty to fall back
# to passthrough serving.
# BUILD-TIME: R2_ACCOUNT_ID / R2_BUCKET / R2_*KEYS, R2_PUBLIC_BASE_URL and
# NEXT_PUBLIC_R2_PUBLIC_BASE_URL must all be present when the app is BUILT —
# the CSP img-src allowlist (next.config.ts) and the NEXT_PUBLIC_* inlining
# are computed at build, so a runtime-only value will not gate images open.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=
# Media kind gate (media-storage-decision phase 2): `images` (default)
# disables video uploads at the sign endpoint + UI; `all` re-enables the
# retained video path once a video provider is chosen.
ARCHITECH_MEDIA_KINDS=images
# Media quota (phase 4): non-deleted media items per listing draft.
MEDIA_MAX_IMAGES_PER_LISTING=10
# Shared-secret bearer token for the internal scheduled jobs (Railway cron
# → /api/internal/scheduled/*). The in-process media-retention timer should
# be set off (MEDIA_RETENTION_SWEEP=off) when the cron drives the sweep.
CRON_SECRET=
# Web-vitals RUM sampling (0..1; 1 = every metric). Lower to 0.05-0.1 at
# scale; set 0 to disable ingest entirely (observability audit P1.3).
NEXT_PUBLIC_WEB_VITALS_SAMPLE_RATE=0.1
RESEND_API_KEY=
GSC_CREDENTIALS=
GUJARAT_RERA_BASE_URL=
GUJARAT_RERA_API_KEY=
PUBLIC_INDEXING_ENABLED=false
INDEXNOW_KEY=
INDEXNOW_HOST=
NEXT_PUBLIC_SITE_HOST=
LEGAL_GATES_ENFORCE_APPROVAL=true
TRUST_PROXY_HEADERS=true
ALLOW_ORIGINLESS_MUTATIONS=false
